---
// The hero's CRT terminal: a WebGPU tube that types the site's claim and then
// streams the operator novellas.
//
// Progressive enhancement, and the fallback is the default. The server renders
// nothing but an empty, hidden canvas; the Canvas2D GlowField and the HTML hero
// copy are what a visitor gets until the surface has actually come up. Only then
// does the hero switch to `data-crt="on"`. If WebGPU is missing, or the adapter
// refuses, or the device is lost, the page stays exactly as it is today.
//
// Everything that is not specific to a terminal — boot, upload, relayout, theme,
// run/stop — lives in src/lib/crt-surface.ts and is shared with the scene fields
// on /blog and /apparel.
---

<canvas class="crt-field" data-crt-field aria-hidden="true"></canvas>

<script>
  import { mountCrtSurface, type CrtSource } from '../lib/crt-surface';
  import { createTerminal } from '../lib/crt-terminal';
  import { CRT_SHADER } from '../lib/crt-shader';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-crt-field]');
  const hero = canvas?.closest<HTMLElement>('.hero');

  /** Frozen from the tuning pass; the prototype's slider panel does not ship. */
  const LOOK = {
    curvature: 0.07,
    bezel: 0.055,
    overscan: 1.1,
    gain: 0.94,
    ior: 2,
    glassDepth: 0.1,
    rimPower: 0.01,
    reflectPower: 0.58,
    scanDepth: 0.32,
    scanCount: 290,
    maskDepth: 0.36,
    glowPower: 0.1,
    glowRadius: 0.005,
    splitAmount: 0.004,
    tearAmount: 0.004,
    tearRate: 20,
    trackingAmount: 1.24,
    dropoutAmount: 0.14,
    rollAmount: 0.24,
    noiseAmount: 0.055,
  };
  const TYPING = { typeSpeed: 31, eraseSpeed: 420, holdSeconds: 10 };

  /** Rows the tube is laid out for, which a phone needs more of than a desktop. */
  const rowsFor = (narrow: boolean) => (narrow ? 34 : 30);

  async function boot() {
    if (!canvas || !hero) return;

    await mountCrtSurface({
      canvas,
      host: hero,
      shader: CRT_SHADER,
      look: LOOK,
      glowTaps: [6, 12],
      // A dark tube can take a deep edge falloff; on paper the same amount reads
      // as dirt and, worse, drops the calls to action sitting on it to 1.06:1
      // against their own background. Measured, not guessed.
      vignette: [0.1, 0.35],

      createSource(aspect, narrow) {
        const term = createTerminal({ aspect, targetRows: rowsFor(narrow) });
        // The terminal predates the shared contract and carries its own typing
        // options and row target; the adapter is where those stay.
        const source: CrtSource = {
          get canvas() { return term.canvas; },
          get width() { return term.width; },
          get height() { return term.height; },
          get dirty() { return term.dirty; },
          get lightPolarity() { return term.lightPolarity; },
          get screenBackground() { return term.screenBackground; },
          tick: (dt) => term.tick(dt, TYPING),
          draw: (time) => term.draw(time),
          drawSignalLoss: () => term.drawSignalLoss(),
          refreshTokens: () => term.refreshTokens(),
          resize: (nextAspect, isNarrow) => term.resize(nextAspect, rowsFor(isNarrow)),
        };
        return source;
      },

      async onReady() {
        // Brackets move into the text because the sl-fx-glitch effect owns ::before
        // and ::after (it renders `attr(data-text)` there), so they cannot also
        // carry punctuation. Done in JS so the fallback button is never touched.
        const primary = hero!.querySelector<HTMLElement>('.hero__actions .sl-btn');
        if (!primary) return;
        const label = `[ ${primary.textContent?.trim()} ]`;
        primary.textContent = label;
        primary.dataset.text = label;
        primary.classList.add('sl-fx-glitch');
        const { hoverBurst } = await import('@sondalab/ui-kit/effects.js');
        hoverBurst(primary, primary, { burstMin: 120, burstMax: 260 });
      },
    });
  }

  void boot();
</script>

<style>
  .crt-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
  }
  /* Only shown once WebGPU has actually produced a device. `.hero` lives in
     Hero.astro, so the selector has to escape this component's scope. */
  :global(.hero[data-crt='on']) .crt-field { display: block; }
</style>
