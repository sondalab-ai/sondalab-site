---
import Wordmark from './Wordmark.astro';

// `keep` survives the narrow-viewport collapse. The home anchors are
// reachable by scrolling anyway; Apparel and Blog are destinations of their
// own, so hiding them on a phone would make those sections unreachable from
// the header.
const nav: { label: string; href: string; keep?: boolean }[] = [
  { label: 'Products', href: '/#products' },
  { label: 'Stance', href: '/#approach' },
  { label: 'Method', href: '/#method' },
  { label: 'Apparel', href: '/apparel/', keep: true },
  { label: 'Blog', href: '/blog/', keep: true },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="sl-header site-header">
  <div class="sl-wrap site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Sondalab home">
      <Wordmark size="1.35rem" />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      {nav.map((n) => <a href={n.href} data-keep={n.keep ? '' : undefined}>{n.label}</a>)}
    </nav>

    <div class="sl-segmented site-header__theme" role="group" aria-label="Colour theme">
      <button class="sl-segmented__item" type="button" data-theme-choice="light" aria-pressed="false">Light</button>
      <button class="sl-segmented__item" type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var items = document.querySelectorAll('[data-theme-choice]');
    function sync() {
      var current = root.getAttribute('data-sl-theme') || 'dark';
      items.forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.getAttribute('data-theme-choice') === current));
      });
    }
    sync();
    items.forEach(function (b) {
      b.addEventListener('click', function () {
        var next = b.getAttribute('data-theme-choice');
        root.setAttribute('data-sl-theme', next);
        try { localStorage.setItem('sl-theme', next); } catch (e) {}
        sync();
      });
    });
  })();
</script>

<style>
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4rem;
  }
  .site-header__brand { text-decoration: none; margin-right: auto; }

  .site-header__nav {
    display: flex;
    gap: 1.75rem;
    font-family: var(--sl-font-mono);
    font-weight: 300;
    font-size: var(--sl-text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .site-header__nav a {
    text-decoration: none;
    color: var(--sl-text-secondary);
    transition: color var(--sl-motion-fast) var(--sl-motion-ease);
  }
  .site-header__nav a:hover { color: var(--sl-text-primary); }

  /* The kit's segmented control, compacted to sit in a 4rem header row. */
  .site-header__theme .sl-segmented__item {
    padding: 0.3rem 0.6rem;
    /* Keeps the pre-0.27 height: the kit moved segmented items to
       line-height 1 for its 32px control height. */
    line-height: normal;
  }

  /* The full nav needs ~800px beside the brand and the toggle; below 52rem it
     overflowed the page (765-776px wide at 560-768). Collapse to the kept
     entries there, not only on phones. scripts/layout-probe.mjs guards it. */
  @media (max-width: 51.99rem) {
    .site-header__nav a:not([data-keep]) { display: none; }
    /* Two entries survive the collapse, so the gap still has to separate them.
       The row gap gives back exactly what the nav gap takes, so the header is
       no wider than it was when the two labels were touching. */
    .site-header__nav { gap: 1rem; }
    .site-header__inner { gap: 1rem; }
  }
  /* Two named themes are wider than the one-word pill they replaced; on a
     phone the row only fits with the items and gaps drawn in. */
  @media (max-width: 26rem) {
    .site-header__inner { gap: 0.5rem; }
    .site-header__nav { gap: 0.6rem; letter-spacing: 0.08em; }
    .site-header__theme .sl-segmented__item { padding: 0.3rem 0.4rem; letter-spacing: 0.06em; }
  }
</style>
