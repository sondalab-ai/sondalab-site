---
import Wordmark from './Wordmark.astro';

// Under 48rem the inline links give way to a Menu button holding all of them,
// so no destination (Contact included) is unreachable on a phone.
const nav: { label: string; href: string }[] = [
  { label: 'Products', href: '/#products' },
  { label: 'Stance', href: '/#approach' },
  { label: 'Method', href: '/#method' },
  { label: 'Apparel', href: '/apparel/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="sl-header site-header">
  <div class="sl-wrap site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Sondalab home">
      <Wordmark size="1.35rem" />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>

    <button class="sl-btn sl-btn--ghost sl-btn--sm site-header__menu" type="button" aria-expanded="false" aria-controls="site-nav-panel" data-menu-button>Menu</button>

    <div class="sl-segmented site-header__theme" role="group" aria-label="Colour theme">
      <button class="sl-segmented__item" type="button" data-theme-choice="light" aria-pressed="false">Light</button>
      <button class="sl-segmented__item" type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
    </div>
  </div>
  <nav id="site-nav-panel" class="site-header__panel sl-wrap" aria-label="Primary" data-menu-panel hidden>
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
  </nav>
</header>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var items = document.querySelectorAll('[data-theme-choice]');
    function sync() {
      var current = root.getAttribute('data-sl-theme') || 'dark';
      items.forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.getAttribute('data-theme-choice') === current));
      });
    }
    sync();

    var button = document.querySelector('[data-menu-button]');
    var panel = document.querySelector('[data-menu-panel]');
    function setMenu(open, refocus) {
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (open) { var first = panel.querySelector('a'); if (first) first.focus(); }
      else if (refocus) button.focus();
    }
    button.addEventListener('click', function () { setMenu(panel.hidden, false); });
    panel.addEventListener('click', function (e) { if (e.target.closest('a')) setMenu(false, false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !panel.hidden) setMenu(false, true); });
    document.addEventListener('click', function (e) {
      if (!panel.hidden && !e.target.closest('.site-header')) setMenu(false, false);
    });
    window.matchMedia('(min-width: 48rem)').addEventListener('change', function (m) { if (m.matches) setMenu(false, false); });

    items.forEach(function (b) {
      b.addEventListener('click', function () {
        var next = b.getAttribute('data-theme-choice');
        root.setAttribute('data-sl-theme', next);
        try { localStorage.setItem('sl-theme', next); } catch (e) {}
        sync();
      });
    });
  })();
</script>

<style>
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4rem;
  }
  .site-header__brand { text-decoration: none; margin-right: auto; }

  /* Nav items are controls (ui-kit 0.30, L1): sentence-case Geist at the
     control step, untracked, as the labels are written in the markup. */
  .site-header__nav {
    display: flex;
    gap: 1.75rem;
    font-family: var(--sl-font-sans);
    font-weight: 500;
    font-size: var(--sl-text-sm);
  }
  .site-header__nav a {
    text-decoration: none;
    color: var(--sl-text-secondary);
    transition: color var(--sl-motion-fast) var(--sl-motion-ease);
  }
  .site-header__nav a:hover { color: var(--sl-text-primary); }

  /* The kit's segmented control at its own 32px height (ui-kit 0.32: a sunk
     track, the chosen item a raised tile), drawn in only across: the header's
     nav collapse was measured against these narrower items. */
  .site-header__theme .sl-segmented__item { padding-inline: 0.6rem; }

  /* The full nav needs ~745px with its gutters at 768px, in sentence-case
     Geist (ui-kit 0.32; ~754px in uppercase Geist Mono, ~824px in Martian
     Mono, collapsed below 52rem); at 46rem it would overflow the page.
     Under 48rem the links move into the Menu panel instead of being hidden.
     scripts/layout-probe.mjs guards it. */
  .site-header__menu { display: none; }
  .site-header__panel { display: flex; flex-direction: column; padding-block: 0.5rem 1rem; }
  .site-header__panel[hidden] { display: none; }
  .site-header__panel a {
    padding-block: 0.65rem;
    text-decoration: none;
    font-family: var(--sl-font-sans);
    font-weight: 500;
    color: var(--sl-text-secondary);
    border-bottom: 1px solid var(--sl-border-subtle);
  }
  .site-header__panel a:hover { color: var(--sl-text-primary); }
  @media (max-width: 47.99rem) {
    .site-header__nav { display: none; }
    .site-header__menu { display: inline-flex; }
    .site-header__inner { gap: 0.75rem; }
  }
  @media (min-width: 48rem) {
    .site-header__panel { display: none; }
  }
  @media (max-width: 26rem) {
    .site-header__inner { gap: 0.5rem; }
    .site-header__theme .sl-segmented__item { padding-inline: 0.4rem; }
  }
</style>
