---
import Wordmark from './Wordmark.astro';
import { SITE } from '../lib/site';
const year = new Date().getFullYear();
// The page ends on a band of signal traces (src/lib/traces.ts), in the
// page's own ink and accent, new on every visit (owner, 2026-11-11). It is
// the site's one new piece of art: the heads carry none.
---

<footer class="site-footer">
  <canvas class="site-footer__band" data-foot-band aria-hidden="true"></canvas>
  <div class="sl-wrap site-footer__inner">
    <div class="site-footer__brand">
      <Wordmark size="1.2rem" />
      <p class="site-footer__claim">{SITE.tagline}</p>
    </div>
    <p class="site-footer__meta">
      © {year} Sondalab · a lab for operators ·{' '}
      <a class="site-footer__feed" href="/design-system/">Design system</a> ·{' '}
      <a class="site-footer__feed" href="/rss.xml">RSS</a>
    </p>
  </div>
</footer>

<script>
  import { mountTraces } from '../lib/traces';
  const band = document.querySelector<HTMLCanvasElement>('[data-foot-band]');
  if (band) mountTraces(band, 1 + Math.floor(Math.random() * 99999));
</script>

<style>
  /* The band is 150px tall, under the footer's content: the bottom padding
     is its height, so the claim and the meta line stay on clear ground above
     it. High contrast and forced colours draw no band, and the footer gives
     the space back. */
  .site-footer {
    border-top: 1px solid var(--sl-border-subtle);
    padding-block: 2.5rem calc(2.5rem + 150px);
    position: relative;
  }
  .site-footer__band {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    width: 100%;
    height: 150px;
    color: color-mix(in srgb, var(--slc-text) 50%, transparent);
    outline-color: var(--slc-accent-text);
    image-rendering: pixelated;
    pointer-events: none;
  }
  :global(:root[data-sl-theme='high-contrast']) .site-footer__band { display: none; }
  :global(:root[data-sl-theme='high-contrast']) .site-footer { padding-block-end: 2.5rem; }
  @media (forced-colors: active) {
    .site-footer { padding-block-end: 2.5rem; }
    .site-footer__band { display: none; }
  }
  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .site-footer__brand { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .site-footer__feed {
    color: var(--sl-text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--sl-border-default);
    transition: color var(--sl-motion-fast) var(--sl-motion-ease);
  }
  .site-footer__feed:hover { color: var(--slc-accent-text); }
  /* Its underline joins the focus ring (site.css): left neutral it is a band. */
  .site-footer__feed:focus-visible { border-bottom-color: var(--slc-focus); }
  .site-footer__claim {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-weight: 500;
    font-size: var(--sl-text-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-text-muted);
  }
  .site-footer__meta {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-weight: var(--mono-hair);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.06em;
    color: var(--sl-text-muted);
  }
</style>
