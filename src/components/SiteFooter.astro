---
import Wordmark from './Wordmark.astro';
import { SITE } from '../lib/site';
const year = new Date().getFullYear();
// The page ends on the wordmark at the page's own width, cut by the bottom
// edge. It is type, not a picture: the brand face, in a faint share of the ink.
---

<footer class="site-footer">
  <div class="sl-wrap site-footer__inner">
    <div class="site-footer__brand">
      <Wordmark size="1.2rem" />
      <p class="site-footer__claim">{SITE.tagline}</p>
    </div>
    <p class="site-footer__meta">
      © {year} Sondalab · a lab for operators ·{' '}
      <a class="site-footer__feed" href="/design-system/">Design system</a> ·{' '}
      <a class="site-footer__feed" href="/rss.xml">RSS</a>
    </p>
  </div>
  <div class="site-footer__mark" aria-hidden="true">sondalab<span>.</span></div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--sl-border-subtle);
    padding-block: 2.5rem 0;
    overflow: hidden;
  }
  .site-footer__mark {
    margin-top: 2.5rem;
    font-family: var(--sl-font-brand);
    font-weight: 500;
    font-size: 26.5vw;
    line-height: 0.72;
    letter-spacing: -0.05em;
    text-align: center;
    white-space: nowrap;
    color: color-mix(in srgb, var(--slc-text) 9%, transparent);
    height: 0.56em;
    user-select: none;
  }
  .site-footer__mark span { color: color-mix(in srgb, var(--sl-accent-default) 55%, transparent); }
  :global(:root[data-sl-theme='high-contrast']) .site-footer__mark { display: none; }
  :global(:root[data-sl-theme='high-contrast']) .site-footer { padding-block-end: 2.5rem; }
  @media (forced-colors: active) {
    .site-footer { padding-block-end: 2.5rem; }
    .site-footer__mark { display: none; }
  }
  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .site-footer__brand { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .site-footer__feed {
    color: var(--sl-text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--sl-border-default);
    transition: color var(--sl-motion-fast) var(--sl-motion-ease);
  }
  .site-footer__feed:hover { color: var(--slc-accent-text); }
  .site-footer__feed:focus-visible { border-bottom-color: var(--slc-focus); }
  .site-footer__claim {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-weight: 500;
    font-size: var(--sl-text-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-text-muted);
  }
  .site-footer__meta {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-weight: var(--mono-hair);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.06em;
    color: var(--sl-text-muted);
  }
</style>
