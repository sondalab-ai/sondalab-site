---
import Wordmark from './Wordmark.astro';
import { SITE } from '../lib/site';
const year = new Date().getFullYear();
// The page ends on the kit's horizon (ui-kit 0.45): a scene at the footer's
// foot, the page as its sky. The script below gives every visit a horizon of
// its own; with no JavaScript the page ends on the kit's canonical hills.
---

<footer class="site-footer sl-art-horizon" data-site-horizon>
  <div class="sl-wrap site-footer__inner">
    <div class="site-footer__brand">
      <Wordmark size="1.2rem" />
      <p class="site-footer__claim">{SITE.tagline}</p>
    </div>
    <p class="site-footer__meta">
      © {year} Sondalab · a lab for operators ·{' '}
      <a class="site-footer__feed" href="/design-system/">Design system</a> ·{' '}
      <a class="site-footer__feed" href="/rss.xml">RSS</a>
    </p>
  </div>
</footer>

<script>
  // A new horizon on every visit (owner, 2026-11-11): a random seed and one
  // of the kit's two scenes. The kit's mountArt() (Base.astro) follows the
  // seed and the class, whichever script runs first, and draws the scene at
  // the footer's real width.
  const foot = document.querySelector<HTMLElement>('[data-site-horizon]');
  if (foot) {
    foot.classList.toggle('sl-art-horizon--dawn', Math.random() < 0.5);
    foot.dataset.slArtSeed = String(1 + Math.floor(Math.random() * 0xfffffffe));
  }
</script>

<style>
  /* The horizon is 200px tall and behind the footer's content: the bottom
     padding is its height, so the claim and the meta line stay on the page
     ground above it. High contrast and forced colours paint no horizon, and
     the footer gives the space back. */
  .site-footer {
    border-top: 1px solid var(--sl-border-subtle);
    padding-block: 2.5rem calc(2.5rem + 200px);
  }
  :global(:root[data-sl-theme='high-contrast']) .site-footer { padding-block-end: 2.5rem; }
  @media (forced-colors: active) {
    .site-footer { padding-block-end: 2.5rem; }
  }
  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .site-footer__brand { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .site-footer__feed {
    color: var(--sl-text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--sl-border-default);
    transition: color var(--sl-motion-fast) var(--sl-motion-ease);
  }
  .site-footer__feed:hover { color: var(--slc-accent-text); }
  /* Its underline joins the focus ring (site.css): left neutral it is a band. */
  .site-footer__feed:focus-visible { border-bottom-color: var(--slc-focus); }
  .site-footer__claim {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-weight: 500;
    font-size: var(--sl-text-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-text-muted);
  }
  .site-footer__meta {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-weight: var(--mono-hair);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.06em;
    color: var(--sl-text-muted);
  }
</style>
