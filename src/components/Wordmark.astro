---
interface Props {
  size?: string;
  as?: string;
}
const { size = '1.4rem', as = 'span' } = Astro.props;
const Tag = as;
---

<Tag class="wordmark" style={`--wm-size:${size}`}>
  <span class="wordmark__name">sondalab</span><span class="wordmark__dot" aria-hidden="true"></span>
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--sl-font-display);
    font-weight: 500;
    font-variation-settings: 'opsz' 40, 'WONK' 0;
    font-size: var(--wm-size);
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--sl-text-primary);
  }
  .wordmark__dot {
    width: 0.28em;
    height: 0.28em;
    border-radius: var(--sl-radius-pill);
    background: var(--sl-accent-default);
    margin-left: 0.12em;
    align-self: flex-end;
    margin-bottom: 0.06em;
  }
</style>
