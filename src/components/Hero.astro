---
import GlowField from './GlowField.astro';
import { SITE } from '../lib/site';

const claimParts = SITE.claim.split(', ');
const accentText = `${claimParts[1]}.`;
const SHARDS = 6;
const shards = Array.from({ length: SHARDS }, (_, i) => i);

// Down-chevron drawn as individual dots (col x, row y) that echo the logo dot.
// Each animates on its own: an eased wave ripples top-to-bottom by default, and
// JS occasionally swaps in an alternate move. `dir` = horizontal sign from the
// centre column (3), used by the left↔right swap variant.
const cue = [
  { x: 0, y: 0 },
  { x: 6, y: 0 },
  { x: 1, y: 1 },
  { x: 5, y: 1 },
  { x: 2, y: 2 },
  { x: 4, y: 2 },
  { x: 3, y: 3 },
].map((p) => ({ ...p, dir: Math.sign(3 - p.x) }));
---

<section class="hero">
  <GlowField />
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="wrap hero__inner">
    <p class="eyebrow hero__eyebrow">Sondalab · a lab for operators</p>

    <h1 class="display hero__claim">
      <span>{claimParts[0]},</span>
      <span
        class="hero__claim-accent glitch glitch--shatter"
        data-text={accentText}
        style={`--n:${SHARDS}`}
      >
        <span class="glitch__text">{accentText}</span>
        <span class="glitch__shards" aria-hidden="true">
          {shards.map((i) => (
            <span class="glitch__shard" style={`--i:${i}`}>{accentText}</span>
          ))}
        </span>
      </span>
    </h1>

    <p class="hero__tagline">{SITE.tagline}</p>

    <div class="hero__actions">
      <a class="sl-btn sl-btn--primary" href="/#products">See what we wire</a>
      <a class="hero__ghost" href="/#approach">What we believe →</a>
    </div>
  </div>

  <a class="hero__scroll" href="/#approach" aria-label="Scroll to content">
    <span class="hero__cue" aria-hidden="true">
      {cue.map((p) => (
        <i class="hero__px" style={`--x:${p.x};--y:${p.y};--d:${p.y};--dir:${p.dir}`}></i>
      ))}
    </span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(34rem, 88vh, 52rem);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  /* Full-bleed readability scrim over the glow, biased to the text side, fades
     fully to transparent so it never reads as a rectangle. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      75% 115% at 26% 52%,
      var(--sl-bg-canvas) 0%,
      color-mix(in srgb, var(--sl-bg-canvas) 45%, transparent) 34%,
      transparent 66%
    );
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    padding-block: 6rem;
  }
  .hero__eyebrow { margin-bottom: 1.75rem; }

  .hero__claim {
    max-width: 18ch;
  }
  .hero__claim span { display: block; }
  .hero__claim-accent {
    color: var(--sl-accent-default);
    font-variation-settings: 'opsz' 144, 'SOFT' 0, 'WONK' 0;
    font-style: italic;
    --gx: 6px; /* bigger split; the display word is large */
  }

  .hero__tagline {
    margin-top: 2rem;
    font-family: var(--sl-font-mono);
    font-weight: 200;
    font-size: var(--sl-text-md);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sl-text-primary);
  }

  .hero__actions {
    margin-top: 2.75rem;
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }
  .hero__ghost {
    font-family: var(--sl-font-mono);
    font-weight: 300;
    font-size: var(--sl-text-sm);
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--sl-text-secondary);
    transition: color var(--sl-motion-fast) var(--sl-motion-ease);
  }
  .hero__ghost:hover { color: var(--sl-text-primary); }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    transform: translateX(-50%);
    z-index: 2;
    display: grid;
    place-items: start center;
    padding: 0.75rem;
  }
  /* Dot chevron, 7 cols x 4 rows, each dot its own element (echoes logo dot). */
  .hero__cue {
    --px: 5px;
    --gap: 8px; /* dot pitch, a touch airier than the dot size */
    --c: var(--sl-accent-default);
    position: relative;
    display: block;
    width: calc(6 * var(--gap) + var(--px));
    height: calc(5 * var(--gap) + var(--px));
  }
  .hero__px {
    position: absolute;
    width: var(--px);
    height: var(--px);
    border-radius: var(--sl-radius-pill);
    left: calc(var(--x) * var(--gap));
    top: calc(var(--y) * var(--gap));
    background: var(--c);
    opacity: 0.25;
    animation: pxwave 1.7s var(--sl-motion-ease) infinite;
    animation-delay: calc(var(--d) * 0.16s);
  }
  /* Default: eased vertical ripple; row-staggered delay flows top-to-bottom. */
  @keyframes pxwave {
    0% { transform: translateY(calc(-1 * var(--gap))); opacity: 0.18; }
    45% { opacity: 1; }
    70% { transform: translateY(calc(1.4 * var(--gap))); opacity: 0.85; }
    100% { transform: translateY(calc(-1 * var(--gap))); opacity: 0.18; }
  }

  /* Occasional variant A: left half slides right, right half slides left. */
  .hero__cue.is-swap .hero__px {
    animation: pxswap 1.3s var(--sl-motion-ease);
    animation-delay: 0s;
  }
  @keyframes pxswap {
    0%, 100% { transform: translateX(0); opacity: 0.85; }
    50% { transform: translateX(calc(var(--dir) * 3 * var(--gap))); opacity: 1; }
  }

  /* Occasional variant B: a bloom that pops outward in a row-staggered wave. */
  .hero__cue.is-pop .hero__px {
    animation: pxpop 1.2s var(--sl-motion-ease);
    animation-delay: calc(var(--d) * 0.1s);
  }
  @keyframes pxpop {
    0%, 100% { transform: scale(1); opacity: 0.55; }
    45% { transform: scale(2); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__px { animation: none; opacity: 0.9; transform: none; }
  }
</style>

<script>
  import { autoBurst } from '../lib/glitch';

  // Every few seconds, briefly swap the hero cue's default wave for an alternate
  // move, chosen at random. Skipped entirely when motion isn't welcome.
  const cue = document.querySelector('.hero__cue');
  if (cue && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const variants: Record<string, number> = { 'is-swap': 1350, 'is-pop': 1250 };
    const keys = Object.keys(variants);
    const schedule = () => {
      const wait = 5000 + Math.random() * 6000;
      setTimeout(() => {
        const v = keys[Math.floor(Math.random() * keys.length)];
        cue.classList.add(v);
        setTimeout(() => {
          cue.classList.remove(v);
          schedule();
        }, variants[v] + 60);
      }, wait);
    };
    schedule();
  }

  // Ambient VHS glitch on the hero accent word, random-length bursts.
  const accent = document.querySelector('.hero__claim-accent.glitch');
  if (accent) autoBurst(accent, { waitMin: 4000, waitMax: 8000 });
</script>
