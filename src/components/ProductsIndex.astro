---
import { getCollection } from 'astro:content';
import { accentVars, type AccentKey } from '../lib/accents';
import { STATUS_META } from '../lib/site';

const NAME_BANDS = 5;
const nameShards = Array.from({ length: NAME_BANDS }, (_, i) => i);

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Which statuses actually appear, for the legend below the list (some products
// carry no status, so drop undefined).
const usedStatuses = [
  ...new Set(products.map((p) => p.data.status).filter(Boolean)),
] as string[];
---

<section id="products" class="section products" data-sl-fx-backdrop>
  <div class="products__bed" aria-hidden="true"></div>
  <div class="wrap">
    <div class="section-index">
      <span class="section-index__no">02</span>
      <span class="eyebrow">The tools</span>
    </div>

    <div class="products__intro">
      <h2 class="h2">Many tools, one throughline.</h2>
      <p class="lede">
        Together they cover the whole loop of working with agents:{' '}
        <strong>writing and running</strong> the work,{' '}
        <strong>watching</strong> every step as it happens,{' '}
        <strong>scoping</strong> what a session loads,{' '}
        <strong>proving</strong> a result repeats,{' '}
        <strong>hosting</strong> it all on hardware you own, and{' '}
        <strong>extending</strong> what an agent can do. Different forms (an
        IDE, dashboards, a launcher, a runtime, a toolbox), one stance
        underneath:{' '}
        <strong>local-first, legible, and yours to switch off</strong>.
      </p>
    </div>

    <ol class="products__list">
      {products.map((p, i) => {
        const acc = accentVars(p.data.accent as AccentKey);
        const meta = p.data.status ? STATUS_META[p.data.status] : null;
        return (
          <li class="gnum-slot" style={`--row-accent-light:${acc.light};--row-accent-dark:${acc.dark}`}>
            <a class="prow glass-thick sl-fx-glass sl-fx-glass--pane sl-fx-aurora" data-curtains data-sl-fx-live="on" href={`/products/${p.id}/`}>
              <span class="sr-only">{i + 1}.</span>
              <span class="prow__rule" aria-hidden="true"></span>
              <div class="prow__main">
                <div class="prow__headline">
                  <h3
                    class="prow__name sl-fx-glitch sl-fx-glitch--shatter"
                    data-text={p.data.name}
                    style={`--slfx-n:${NAME_BANDS}`}
                  >
                    <span class="sl-fx-glitch__text">{p.data.name}</span>
                    <span class="sl-fx-glitch__shards" aria-hidden="true">
                      {nameShards.map((i) => (
                        <span class="sl-fx-glitch__shard" style={`--slfx-i:${i}`}>{p.data.name}</span>
                      ))}
                    </span>
                  </h3>
                  {meta && <span class="prow__status">{meta.label}</span>}
                </div>
                <p class="prow__tagline">{p.data.tagline}</p>
                <p class="prow__summary" set:html={p.data.summary}></p>
              </div>
              <span class="prow__form">{p.data.form}</span>
              <span class="prow__go" aria-hidden="true">→</span>
            </a>
            <span class="gnum glass-thick sl-fx-glass sl-fx-glass--pane sl-fx-glass--text"
                  data-num={String(i + 1).padStart(2, '0')}
                  aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </li>
        );
      })}
    </ol>

    <dl class="legend" aria-label="Status legend">
      {usedStatuses.map((s) => (
        <div class="legend__item">
          <dt class="legend__term">{STATUS_META[s].label}</dt>
          <dd class="legend__desc">{STATUS_META[s].note}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /* The rows sat on the page's flat ground, which is the whole reason they did
     not read as glass: a backdrop filter with nothing behind it blurs nothing,
     and the GPU tier has nothing to bend. So the section declares a bed of its
     own — the same plate the stance uses, at 45% of its strength, because a
     list of tools is something to read and not a statement.

     The plate is a file rather than CSS gradients for the reason written out
     in Thesis.astro and in scripts/make-backdrops.mjs: effects-gpu.js samples
     a url() and nothing else. */
  .products {
    position: relative;
    --slfx-backdrop: url('/backdrops/products-dark.svg');
  }
  :root[data-sl-theme='light'] .products {
    --slfx-backdrop: url('/backdrops/products-light.svg');
  }
  .products__bed {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: var(--slfx-backdrop) center / cover no-repeat;
  }
  .products .wrap { position: relative; z-index: 1; }

  .products__intro {
    max-width: 40rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .products__intro .lede { margin-top: 1.25rem; max-width: 46ch; }
  .products__intro .lede strong {
    font-weight: 600;
    color: var(--sl-text-primary);
  }

  .products__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.85rem, 2vw, 1.4rem);
  }

  .products__list li { --row-accent: var(--row-accent-dark); }
  :root[data-sl-theme='light'] .products__list li { --row-accent: var(--row-accent-light); }

  /* The numeral is a sibling now, not a cell, and the left padding is its
     gutter. See site.css: a pane inside a pane gets no lens. */
  .prow {
    display: grid;
    grid-template-columns: 3px 1fr auto auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(1.5rem, 3.5vw, 2.5rem);
    padding-inline: clamp(0.5rem, 2vw, 1.25rem);
    margin-inline: clamp(-0.5rem, -2vw, -1.25rem);
    /* The numeral's gutter, and it has to come AFTER padding-inline — a
       shorthand written later resets the longhand, which is how this row kept
       its original 20px and let its text run under the figure. Plus what the
       bleed takes back: the row starts left of its slot, so the slot's gutter
       is short by exactly that margin. */
    padding-left: calc(var(--gnum-gutter) - clamp(-0.5rem, -2vw, -1.25rem));
    text-decoration: none;
    color: inherit;
    /* NO `transition` shorthand here. The kit puts one on .sl-fx-glass--pane —
       `transform 420ms`, which is what animates the swell under the pointer —
       and a shorthand on the same element replaces it wholesale: measured, this
       row computed `transition-property: background` and its scale jumped,
       while the pillars and the method's cards, which declare none, eased.
       Restating the kit's curve here would only copy a value it is free to
       retune. The hover tint is a 6% mix, and losing its fade costs less than
       losing the swell. */
    /* See Thesis.astro: at rest a ghost pane carries no edge of its own. */
    border: 1px solid var(--slc-border);
    border-radius: var(--sl-radius-md);
  }
  .prow:hover {
    background: color-mix(in srgb, var(--row-accent) 6%, transparent);
  }
  .prow:focus-visible {
    outline: var(--sl-focus-ring-width) solid var(--sl-accent-default);
    outline-offset: 2px;
  }

  .prow__go {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-lg);
    color: var(--row-accent);
    opacity: 0;
    transform: translateX(-0.4rem);
    transition: opacity var(--sl-motion-mid) var(--sl-motion-ease),
      transform var(--sl-motion-mid) var(--sl-motion-ease);
  }
  .prow:hover .prow__go { opacity: 1; transform: translateX(0); }

  /* The row's accent reaches the figure through its glow — the glass itself is
     colourless by construction, being a lens. */
  /* :global because the kit creates this element at runtime, so it never
     carries the scope attribute Astro stamps on this component's own markup. */
  .gnum-slot:has(.prow:hover) :global(.sl-fx-glass__glow) {
    text-shadow:
      0 0 6px color-mix(in srgb, var(--row-accent) 62%, transparent),
      0 0 34px color-mix(in srgb, var(--row-accent) 34%, transparent);
  }

  .prow__rule {
    align-self: stretch;
    width: 3px;
    background: var(--row-accent);
    border-radius: var(--sl-radius-pill);
    transform: scaleY(0.35);
    transform-origin: center;
    opacity: 0.55;
    transition: transform var(--sl-motion-mid) var(--sl-motion-ease),
      opacity var(--sl-motion-mid) var(--sl-motion-ease);
  }
  .prow:hover .prow__rule { transform: scaleY(1); opacity: 1; }

  .prow__headline {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .prow__name {
    font-family: var(--sl-font-display);
    font-weight: 440;
    font-variation-settings: 'opsz' 60, 'WONK' 1;
    font-size: var(--step-h3);
    margin: 0;
    letter-spacing: -0.01em;
    --gx: 3px;
  }
  .prow__status {
    font-family: var(--sl-font-mono);
    font-weight: 300;
    font-size: var(--sl-text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--row-accent);
    padding: 0.15em 0.6em;
    border: 1px solid color-mix(in srgb, var(--row-accent) 45%, transparent);
    border-radius: var(--sl-radius-pill);
  }
  .prow__tagline {
    margin: 0.5rem 0 0;
    color: var(--sl-text-secondary);
    max-width: 48ch;
  }
  .prow__summary {
    margin: 0.6rem 0 0;
    font-size: var(--sl-text-sm);
    line-height: var(--sl-line-normal);
    color: var(--sl-text-muted);
    max-width: 62ch;
  }
  .prow__summary :global(strong) {
    font-weight: 600;
    color: var(--sl-text-secondary);
  }
  .prow__form {
    font-family: var(--sl-font-mono);
    font-weight: 200;
    font-size: var(--sl-text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sl-text-muted);
  }

  .legend {
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-border-subtle);
  }
  .legend__item { display: flex; align-items: baseline; gap: 0.6rem; }
  .legend__term {
    font-family: var(--sl-font-mono);
    font-weight: 300;
    font-size: var(--sl-text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-text-primary);
  }
  .legend__desc {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-text-muted);
  }

  @media (max-width: 40rem) {
    .prow {
      grid-template-columns: 1fr;
      gap: 0.75rem 1.25rem;
      padding-left: clamp(1.25rem, 5vw, 2rem);
    }
    .prow__rule { display: none; }
    .prow__form { display: none; }
    .prow__go { display: none; }
    /* No room for a 152px figure beside the text on a phone: the numeral is
       decorative and the screen reader already has the number. */
    .gnum, :global(.sl-fx-glass__glow) { display: none; }
  }
</style>

<script>
  import { hoverBurst, scramble } from '@sondalab/ui-kit/effects.js';
  // Hovering a product row glitches its name (bursts) and decode-scrambles its
  // numeral once; two distinct effects on the same trigger.
  //
  // The numeral is the row's SIBLING now — it cannot be a child, because a pane
  // inside a pane gets no lens — so it is reached through the slot.
  // glass-numerals.ts re-cuts that one mask as the digits change, so the decode
  // reads THROUGH the glass; it re-cut all twelve once, and that is what stopped
  // the glitch bursts sharing the same frames.
  for (const row of document.querySelectorAll('.prow')) {
    const name = row.querySelector('.prow__name.sl-fx-glitch');
    if (name) hoverBurst(row, name);
    const no = row.parentElement?.querySelector('.gnum');
    if (no) row.addEventListener('mouseenter', () => scramble(no as HTMLElement));
  }
</script>
