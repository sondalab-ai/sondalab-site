---
import { getCollection } from 'astro:content';
import { accentVars, type AccentKey } from '../lib/accents';
import { STATUS_META } from '../lib/site';

const NAME_BANDS = 5;
const nameShards = Array.from({ length: NAME_BANDS }, (_, i) => i);

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Two shelves, each numbered from 01: the tools, then the research benches.
const shelves = [
  { kind: 'product', label: 'Products', items: products.filter((p) => p.data.kind === 'product') },
  { kind: 'research', label: 'Research', items: products.filter((p) => p.data.kind === 'research') },
];

// Which statuses actually appear, for the legend below the list (some products
// carry no status, so drop undefined).
const usedStatuses = [
  ...new Set(products.map((p) => p.data.status).filter(Boolean)),
] as string[];
---

<section id="products" class="sl-section products">
  <div class="products__bed sl-art-field" aria-hidden="true"></div>
  <div class="sl-wrap">
    <div class="sl-section__head">
      <span class="sl-section__idx">02</span>
      <span class="sl-eyebrow sl-eyebrow--mark">The tools</span>
    </div>

    <div class="products__intro">
      <h2 class="h2">Many tools, one throughline.</h2>
      <p class="lede">
        Together they cover the whole loop of working with agents:{' '}
        <strong>writing and running</strong> the work,{' '}
        <strong>watching</strong> every step as it happens,{' '}
        <strong>scoping</strong> what a session loads,{' '}
        <strong>hosting</strong> it all on hardware you own, and{' '}
        <strong>extending</strong> what an agent can do. Different forms (an
        IDE, dashboards, a launcher, a runtime, a toolbox), one stance
        underneath:{' '}
        <strong>local-first, legible, and yours to switch off</strong>.
      </p>
    </div>

    {shelves.map((shelf) => (
      <div class={`shelf shelf--${shelf.kind}`}>
        {shelf.kind === 'research' && (
          <div class="shelf__head">
            <h3 class="shelf__title">{shelf.label}</h3>
            <p class="shelf__lede">
              Where we test an idea before it becomes a tool: whether an answer
              can be made to <strong>repeat</strong>, and whether a coding agent
              can <strong>carry its project's experience</strong> from one
              session to the next.
            </p>
          </div>
        )}
        <ol class={`products__list mosaic mosaic--${shelf.kind}`}>
          {shelf.items.map((p, i) => {
            // The research shelf sits under its own h3, so its names step down.
            const Name = shelf.kind === 'research' ? 'h4' : 'h3';
            const acc = accentVars(p.data.accent as AccentKey);
            const meta = p.data.status ? STATUS_META[p.data.status] : null;
            return (
              <li class="gnum-slot" style={`--row-accent-light:${acc.light};--row-accent-dark:${acc.dark}`}>
                <a class="prow glass-thick sl-fx-glass sl-fx-glass--pane sl-fx-aurora" data-sl-fx-live="on" href={`/products/${p.id}/`}>
                  <span class="sr-only">{i + 1}.</span>
                  <span class="prow__rule" aria-hidden="true"></span>
                  <div class="prow__main">
                    <div class="prow__headline">
                      <Name
                        class="prow__name sl-fx-glitch sl-fx-glitch--shatter"
                        data-text={p.data.name}
                        style={`--slfx-n:${NAME_BANDS}`}
                      >
                        <span class="sl-fx-glitch__text">{p.data.name}</span>
                        <span class="sl-fx-glitch__shards" aria-hidden="true">
                          {nameShards.map((i) => (
                            <span class="sl-fx-glitch__shard" style={`--slfx-i:${i}`}>{p.data.name}</span>
                          ))}
                        </span>
                      </Name>
                      {meta && <span class="sl-tag">{meta.label}</span>}
                    </div>
                    <p class="prow__tagline">{p.data.tagline}</p>
                    <p class="prow__summary" set:html={p.data.summary}></p>
                  </div>
                  <span class="prow__form">{p.data.form}</span>
                  <span class="prow__go" aria-hidden="true">→</span>
                </a>
                <span class="gnum glass-thick sl-fx-glass sl-fx-glass--pane sl-fx-glass--text"
                      data-num={String(i + 1).padStart(2, '0')}
                      aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              </li>
            );
          })}
        </ol>
      </div>
    ))}

    <dl class="legend" aria-label="Status legend">
      {usedStatuses.map((s) => (
        <div class="legend__item">
          <dt class="legend__term">{STATUS_META[s].label}</dt>
          <dd class="legend__desc">{STATUS_META[s].note}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /* The rows sat on the page's flat ground, which is the whole reason they did
     not read as glass: a backdrop filter with nothing behind it blurs nothing,
     and the lens has nothing to bend. So the section declares a bed of its
     own — soft blooms at 45% of full strength, because a list of tools is
     something to read and not a statement. */
  .products {
    position: relative;
    --bed: url('../assets/backdrops/products-dark.svg');
  }
  :root[data-sl-theme='light'] .products {
    --bed: url('../assets/backdrops/products-light.svg');
  }
  .products__bed {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: var(--bed) center / cover no-repeat;
  }
  .products .sl-wrap { position: relative; z-index: 1; }

  .products__intro {
    max-width: 40rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .products__intro .lede { margin-top: 1.25rem; max-width: 46ch; }
  .products__intro .lede strong {
    font-weight: 600;
    color: var(--sl-text-primary);
  }

  /* A mosaic on a 12-column grid. Products: the flagship is a tall tile on
     the left, the next two stack beside it, the last two split a row.
     Research: two equal tiles. Each tile's numeral sits in its top-left
     corner, so the grid needs no gutter for it. */
  .products__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(0.85rem, 2vw, 1.4rem);
  }
  .products__list > li { display: grid; grid-column: span 6; }
  .mosaic--product > li:nth-child(1) { grid-column: span 7; grid-row: span 2; }
  .mosaic--product > li:nth-child(2),
  .mosaic--product > li:nth-child(3) { grid-column: span 5; }

  .shelf + .shelf { margin-top: clamp(3rem, 7vw, 5rem); }
  .shelf__head {
    max-width: 40rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .shelf__title {
    font-family: var(--sl-font-display);
    font-weight: 600;
    font-size: var(--step-h3);
    letter-spacing: -0.03em;
    margin: 0;
  }
  .shelf__lede {
    margin: 0.75rem 0 0;
    color: var(--sl-text-secondary);
    max-width: 52ch;
  }
  .shelf__lede strong { font-weight: 600; color: var(--sl-text-primary); }

  .products__list li { --row-accent: var(--row-accent-dark); }
  :root[data-sl-theme='light'] .products__list li { --row-accent: var(--row-accent-light); }
  /* The row's hue as text and thin lines, and the tag's wash in it. The kit
     derives both on :root from the default accent, so a row re-derives them
     from its own hue with the kit's formulas (components.css): on light the
     text caps the lightness at --sl-accent-text-lmax, elsewhere it is the hue.
     --slc-accent itself is left alone, so the glass and aurora keep theirs.
     The wash is 12% over the surface, as the kit's contract describes it, and
     not over nothing: the tag sits on the row's lens, which refracts bright
     streaks of the bed under it, and on a see-through wash spexr's tag read
     3.72:1 (dark) and introspect's 4.18:1 (light). */
  .products__list li {
    --row-accent-text: oklch(from var(--row-accent) min(l, var(--sl-accent-text-lmax, 1)) c h);
    --slc-accent-text: var(--row-accent-text);
    --slc-accent-subtle: color-mix(in srgb, var(--row-accent) 12%, var(--slc-surface));
  }

  /* The numeral is the tile's sibling, not a child (site.css: a pane inside
     a pane gets no lens), pinned to the tile's top-left corner. The tile's top
     padding is the numeral's band: its height (line-height 0.8) plus the
     inset above and a gap below. */
  .gnum-slot {
    --gnum-size: clamp(2.75rem, 1rem + 4.5vw, 4.75rem);
    --gnum-inset: clamp(1.1rem, 2.4vw, 1.75rem);
  }
  .mosaic--product > .gnum-slot:first-child {
    --gnum-size: clamp(2.75rem, 1rem + 8vw, 7rem);
  }
  .gnum-slot > .gnum,
  .gnum-slot > :global(.sl-fx-glass__glow) {
    top: var(--gnum-inset);
    translate: none;
  }
  .gnum-slot > .gnum { font-size: var(--gnum-size); }

  .prow {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: var(--gnum-inset);
    padding-top: calc(var(--gnum-inset) + var(--gnum-size) * 0.8 + 1.25rem);
    text-decoration: none;
    color: inherit;
    /* NO `transition` shorthand here. The kit puts one on .sl-fx-glass--pane —
       `transform 420ms`, which is what animates the swell under the pointer —
       and a shorthand on the same element replaces it wholesale: measured, this
       row computed `transition-property: background` and its scale jumped,
       while the pillars and the method's cards, which declare none, eased.
       Restating the kit's curve here would only copy a value it is free to
       retune. The hover tint is a 6% mix, and losing its fade costs less than
       losing the swell. */
    /* The glass ring is quiet at rest, so the pane needs a hairline of its own or it has no edge. */
    border: 1px solid var(--slc-border);
    border-radius: var(--sl-radius-md);
  }
  .prow:hover {
    background: color-mix(in srgb, var(--row-accent) 6%, transparent);
  }
  /* The kit's flush ring, by hand (a row is not a kit control). The border
     joins it, and the pane's pale rim inside the border (glass.css __shine)
     stands down, as the kit's own glass controls do under focus: either one
     left inside the ring is a band of another colour. */
  .prow:focus-visible {
    outline: var(--sl-focus-ring-width) solid var(--slc-focus);
    outline-offset: var(--sl-focus-ring-offset);
    border-color: var(--slc-focus);
    --slg-rim-hi: transparent;
    --slg-rim-lo: transparent;
  }

  .prow__main { flex: 1; }
  /* The flagship tile is two rows tall: its copy sits at the foot, under a
     larger tagline, rather than leaving the lower half empty. */
  .mosaic--product > li:first-child .prow__main {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .mosaic--product > li:first-child .prow__tagline { font-size: var(--sl-text-lg); }
  .prow__go {
    position: absolute;
    right: var(--gnum-inset);
    bottom: var(--gnum-inset);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-lg);
    color: var(--row-accent-text);
    opacity: 0;
    transform: translateX(-0.4rem);
    transition: opacity var(--sl-motion-mid) var(--sl-motion-ease),
      transform var(--sl-motion-mid) var(--sl-motion-ease);
  }
  .prow:hover .prow__go { opacity: 1; transform: translateX(0); }

  /* The row's accent reaches the figure through its glow — the glass itself is
     colourless by construction, being a lens. */
  /* :global because the kit creates this element at runtime, so it never
     carries the scope attribute Astro stamps on this component's own markup. */
  .gnum-slot:has(.prow:hover) :global(.sl-fx-glass__glow) {
    text-shadow:
      0 0 6px color-mix(in srgb, var(--row-accent) 62%, transparent),
      0 0 34px color-mix(in srgb, var(--row-accent) 34%, transparent);
  }

  .prow__rule {
    width: 2.5rem;
    height: 3px;
    background: var(--row-accent-text);
    border-radius: var(--sl-radius-pill);
    transform: scaleX(0.5);
    transform-origin: left;
    opacity: 0.55;
    transition: transform var(--sl-motion-mid) var(--sl-motion-ease),
      opacity var(--sl-motion-mid) var(--sl-motion-ease);
  }
  .prow:hover .prow__rule { transform: scaleX(1); opacity: 1; }

  .prow__headline {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .prow__name {
    font-family: var(--sl-font-display);
    font-weight: 600;
    font-size: var(--step-h3);
    margin: 0;
    letter-spacing: -0.03em;
    --gx: 3px;
  }
  /* The tagline and the summary take the primary ink, not the secondary and
     the muted: the row's lens refracts bright streaks of the bed behind them,
     and over the brightest the secondary read 3.73-4.44:1 and the muted 2.58:1
     (dark, contrast-probe). The primary reads >= 6.02:1 there. The row keeps
     its order by size and weight; in the summary, emphasis is the weight. */
  .prow__tagline {
    margin: 0.5rem 0 0;
    color: var(--slc-text);
    max-width: 48ch;
  }
  .prow__summary {
    margin: 0.6rem 0 0;
    font-size: var(--sl-text-sm);
    line-height: var(--sl-line-normal);
    color: var(--slc-text);
    max-width: 62ch;
  }
  .prow__summary :global(strong) { font-weight: 600; }
  /* A micro label (ui-kit 0.30, L1). The primary ink for the same reason as
     the summary: the label sits on the lens too, and the secondary read
     3.76:1 there (light). */
  .prow__form {
    position: absolute;
    top: var(--gnum-inset);
    right: var(--gnum-inset);
    font-family: var(--sl-font-mono);
    font-weight: 500;
    font-size: var(--sl-text-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--slc-text);
  }

  .legend {
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-border-subtle);
  }
  .legend__item { display: flex; align-items: baseline; gap: 0.6rem; }
  .legend__term {
    font-family: var(--sl-font-mono);
    font-weight: 500;
    font-size: var(--sl-text-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-text-primary);
  }
  .legend__desc {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-text-muted);
  }

  @media (max-width: 52rem) {
    .products__list > li,
    .mosaic--product > li:nth-child(n) { grid-column: 1 / -1; grid-row: auto; }
  }
</style>

<script>
  import { hoverBurst, scramble } from '@sondalab/ui-kit/effects.js';
  // Hovering a product row glitches its name (bursts) and decode-scrambles its
  // numeral once; two distinct effects on the same trigger.
  //
  // The numeral is the row's SIBLING now — it cannot be a child, because a pane
  // inside a pane gets no lens — so it is reached through the slot.
  // glass-numerals.ts re-cuts that one mask as the digits change, so the decode
  // reads THROUGH the glass; it re-cut all twelve once, and that is what stopped
  // the glitch bursts sharing the same frames.
  for (const row of document.querySelectorAll('.prow')) {
    const name = row.querySelector('.prow__name.sl-fx-glitch');
    if (name) hoverBurst(row, name);
    const no = row.parentElement?.querySelector('.gnum');
    if (no) row.addEventListener('mouseenter', () => scramble(no as HTMLElement));
  }
</script>
