---
// A terminal transcript as text: real ADS output on the ink, one line per
// entry, each role line painted with its terminal role (sondalab-ui
// tui-patterns.md). The block itself is the shared .ink-pre (site.css), which
// the ADS docs' example blocks wear too.
import type { TranscriptLine } from '../lib/ads-page';

interface Props {
  lines: readonly TranscriptLine[];
  label: string;
}
const { lines, label } = Astro.props;
---

<figure class="transcript"><pre class="ink-pre" aria-label={label} tabindex="0">{lines.map((l, i) => <Fragment>{l.role ? <span class={`t-${l.role}`}>{l.text}</span> : l.text}{i < lines.length - 1 ? '\n' : ''}</Fragment>)}</pre></figure>

<style>
  .transcript { margin: 0; min-width: 0; }
  /* Status hues lifted toward the block's text so they read on the ink
     (design-language.md §Decision 2). */
  .t-prompt { color: color-mix(in srgb, var(--slc-accent) 55%, var(--slc-canvas)); font-weight: 600; }
  .t-ok { color: color-mix(in srgb, var(--slc-success) 45%, var(--slc-canvas)); }
  .t-warn { color: color-mix(in srgb, var(--slc-warning) 45%, var(--slc-canvas)); }
  .t-err { color: color-mix(in srgb, var(--slc-danger) 45%, var(--slc-canvas)); }
  .t-dim { color: color-mix(in srgb, var(--slc-canvas) 62%, var(--slc-text)); }
  .t-accent { color: color-mix(in srgb, var(--slc-info, var(--slc-accent)) 50%, var(--slc-canvas)); font-weight: 600; }
</style>
