---
import intent from '../assets/method/intent.png';
import work from '../assets/method/work.png';
import check from '../assets/method/check.png';

const points = [
  {
    step: 'Intent',
    claim: 'We write the intent first.',
    proof: 'Every change starts as a written decision, before an agent touches a file.',
    scene: intent,
  },
  {
    step: 'Work',
    claim: 'The machines show their work.',
    proof: 'Each step is visible while it runs and traceable afterwards, so nothing lands unexplained.',
    scene: work,
  },
  {
    step: 'Check',
    claim: "Drift doesn't ship.",
    proof: 'A design audit and a content schema stop the build on any mismatch. This page passed both.',
    scene: check,
  },
];
---

<section id="method" class="sl-section method">
  <div class="method__bed" aria-hidden="true"></div>
  <div class="sl-wrap method__grid">
    <div class="method__head">
      <div class="sl-section__head">
        <span class="sl-section__idx">03</span>
        <span class="sl-eyebrow">The method</span>
      </div>
      <h2 class="h2">We run on our own tools first.</h2>
      <p class="lede">
        Sondalab is built by directing agents with the same tools we ship.{' '}
        <strong>What reaches you has already carried our own work.</strong>
      </p>
    </div>

    <ol class="rail">
      {points.map((p, i) => (
        <li class="rail__step">
          <div class="rail__text">
            <span class="rail__n"><span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="rail__label">{p.step}</span></span>
            <h3 class="rail__claim">{p.claim}</h3>
            <p class="rail__proof">{p.proof}</p>
          </div>
          <canvas class="mscene" data-sl-halftone data-sl-src={p.scene.src} aria-hidden="true"></canvas>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* The bed, the same plate as the stance and the tools. */
  .method {
    position: relative;
    --bed: url('../assets/backdrops/method-dark.svg');
  }
  :root[data-sl-theme='light'] .method {
    --bed: url('../assets/backdrops/method-light.svg');
  }
  .method__bed {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: var(--bed) center / cover no-repeat;
  }
  .method .sl-wrap { position: relative; z-index: 1; }

  .method__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  @media (min-width: 48rem) {
    .method__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: start;
    }
  }
  .method__head .h2 { margin-top: 1.25rem; max-width: 16ch; }
  .method__head .lede { margin-top: 1.5rem; max-width: 42ch; }
  .method__head .lede strong { font-weight: 600; color: var(--sl-text-primary); }

  /* The rail: one line through three nodes, intent → work → check. The
     pseudo-elements set their own box-sizing, because the site's `*` rule does
     not match pseudo-elements, and a 16px ring with a 2px border otherwise
     renders 20px wide and sits 2px off the line. */
  .rail {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    --node: 16px;
    --label-lh: 1.5rem;
  }
  .rail__step {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    padding: 0 0 clamp(2rem, 4vw, 3rem) calc(var(--node) + 2rem);
  }
  .rail__step:last-child { padding-bottom: 0; }
  /* The line, drawn per step from this node's centre to the next one's, so it
     starts and ends on a node whatever the last promise and its vignette
     measure. The fade runs across the two segments: accent to half, half to
     15%. */
  .rail__step:not(:last-child)::after {
    content: '';
    box-sizing: border-box;
    position: absolute;
    left: calc(var(--node) / 2 - 1px);
    top: calc(var(--label-lh) / 2);
    bottom: calc(var(--label-lh) / -2);
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--slc-accent-text),
      color-mix(in srgb, var(--slc-accent-text) 57%, transparent)
    );
  }
  .rail__step:nth-child(2)::after {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--slc-accent-text) 57%, transparent),
      color-mix(in srgb, var(--slc-accent-text) 15%, transparent)
    );
  }
  .rail__step::before {
    content: '';
    box-sizing: border-box;
    position: absolute;
    left: 0;
    /* Level with the step label's centre: the label's line is --label-lh tall. */
    top: calc(var(--label-lh) / 2 - var(--node) / 2);
    width: var(--node);
    height: var(--node);
    border-radius: 50%;
    background: var(--sl-bg-canvas);
    border: 2px solid var(--slc-accent-text);
    z-index: 1;
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--sl-accent-default) 14%, transparent);
  }
  /* Text and vignette side by side only where the rail column can hold both:
     below 72rem the vignette sits under its promise. */
  @media (min-width: 72rem) {
    .rail__step {
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 2rem;
      align-items: start;
    }
  }

  .rail__n {
    display: block;
    line-height: var(--label-lh);
    margin-bottom: 0.2rem;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.1em;
    color: var(--slc-accent-text);
  }
  .rail__label {
    margin-left: 0.75rem;
    font-size: var(--sl-text-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-text-secondary);
  }
  .rail__claim {
    margin: 0;
    font-family: var(--sl-font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 1rem + 1.8vw, 2.3rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--sl-text-primary);
  }
  .rail__proof {
    margin: 0.7rem 0 0;
    max-width: 40ch;
    line-height: var(--sl-line-normal);
    color: var(--sl-text-secondary);
  }

  /* The vignette: scene art as dots, the kit's halftone (armed by mount() in
     Base.astro). Decorative; without JavaScript it is simply empty. */
  .mscene { display: block; width: 180px; height: 180px; }
  @media (min-width: 48rem) {
    .mscene { width: 240px; height: 240px; }
  }
  @media (min-width: 72rem) {
    .mscene { width: 280px; height: 280px; }
  }
</style>
