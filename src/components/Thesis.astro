---
const pillars = [
  {
    verb: 'See it',
    body: 'Whatever a machine is doing, Sondalab <strong>keeps it legible</strong>: observable, measurable, understandable as it happens. <strong>No black boxes.</strong>',
  },
  {
    verb: 'Steer it',
    body: 'You <strong>stay in the loop and in charge</strong>: direct it, correct it, hand off or take the controls back at any moment. <strong>Assistance, never autopilot.</strong>',
  },
  {
    verb: 'Own it',
    body: 'The machine, its data and <strong>its off-switch stay yours</strong>, answering to you, <strong>running where you are</strong>, not to a service out of reach.',
  },
];
---

<section id="approach" class="section invert thesis" data-sl-fx-backdrop>
  <div class="thesis__bed" aria-hidden="true"></div>
  <div class="wrap thesis__grid">
    <div class="thesis__head">
      <div class="section-index">
        <span class="section-index__no">01</span>
        <span class="eyebrow">The stance</span>
      </div>
      <h2 class="h2">Tools that keep you in command of the machines working for you.</h2>
      <p class="lede">
        Sondalab builds software that{' '}
        <strong>runs, watches and improves</strong> the agents doing your work,
        and keeps them <strong>legible, controllable and yours</strong>. It's a
        stance that holds as machines grow more capable: from today's software
        agents toward the physical systems, and <strong>robotics</strong>, ahead.
      </p>
    </div>

    <ol class="thesis__pillars">
      {pillars.map((p, i) => (
        <li class="pillar sl-fx-glass sl-fx-glass--pane sl-fx-aurora" data-curtains>
          <span class="pillar__no">{String(i + 1).padStart(2, '0')}</span>
          <div class="pillar__body">
            <h3 class="pillar__verb">{p.verb}</h3>
            <p set:html={p.body}></p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* The bed. A pane laid on a flat slab shows nothing — it has no structure
     to blur and no colour to carry — so the band gets a field of soft blooms
     in the brand pair, ruled so the blur has an edge to bend rather than a
     gradient blurring into itself. Painted first and left under the content,
     which is what puts it in each pane's backdrop.

     It is a PLATE, not a stack of CSS gradients, and that is not a style
     choice: the GPU tier bends what a pane declares through --slfx-backdrop,
     and effects-gpu.js takes a url() and nothing else, because a gradient
     cannot be sampled. So the same file paints the bed and feeds the shader,
     which is what keeps the two from drifting. scripts/make-backdrops.mjs
     generates it from the kit's own theme tokens. */
  .thesis {
    position: relative;
    --slfx-backdrop: url('/backdrops/thesis-dark.svg');
  }
  :root[data-sl-theme='light'] .thesis {
    --slfx-backdrop: url('/backdrops/thesis-light.svg');
  }
  .thesis__bed {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: var(--slfx-backdrop) center / cover no-repeat;
  }

  .thesis__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  @media (min-width: 52rem) {
    .thesis__grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }
    .thesis__head {
      position: sticky;
      top: 6rem;
    }
  }
  .thesis__head .h2 { margin-top: 1.25rem; max-width: 16ch; }
  .thesis__head .lede { margin-top: 1.5rem; }

  .thesis__pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.85rem, 2vw, 1.4rem);
  }
  .pillar {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    --slg-radius: var(--sl-radius-lg);
    /* The hairline the transparent buttons have. The glass ring on ::after
       lights on hover and is quiet at rest by the owner's own earlier ruling,
       so at rest a ghost pane needs an edge of its own or it has none. */
    border: 1px solid var(--slc-border);
    border-radius: var(--sl-radius-lg);
  }

  .pillar__no {
    font-family: var(--sl-font-mono);
    font-weight: 100;
    font-size: var(--step-numeral);
    line-height: 0.8;
    color: color-mix(in srgb, var(--sl-bg-canvas) 30%, transparent);
  }
  .pillar__verb {
    font-family: var(--sl-font-display);
    font-weight: 440;
    font-variation-settings: 'opsz' 72, 'WONK' 1;
    font-size: var(--step-h3);
    margin: 0 0 0.5rem;
    color: var(--sl-bg-canvas);
  }
  .pillar__body p {
    margin: 0;
    max-width: 42ch;
    color: color-mix(in srgb, var(--sl-bg-canvas) 76%, transparent);
  }
  .thesis__head .lede strong,
  .pillar__body :global(strong) {
    font-weight: 600;
    color: var(--sl-bg-canvas);
  }
</style>
