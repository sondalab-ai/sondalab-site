---
import see from '../assets/stance/see.png';
import steer from '../assets/stance/steer.png';
import own from '../assets/stance/own.png';

const pillars = [
  {
    verb: 'See it',
    body: 'Whatever a machine is doing, Sondalab <strong>keeps it legible</strong>: observable, measurable, understandable as it happens. <strong>No black boxes.</strong>',
    scene: see,
  },
  {
    verb: 'Steer it',
    body: 'You <strong>stay in the loop and in charge</strong>: direct it, correct it, hand off or take the controls back at any moment. <strong>Assistance, never autopilot.</strong>',
    scene: steer,
  },
  {
    verb: 'Own it',
    body: 'The machine, its data and <strong>its off-switch stay yours</strong>, answering to you, <strong>running where you are</strong>, not to a service out of reach.',
    scene: own,
  },
];
---

<section id="approach" class="sl-section sl-invert thesis">
  <div class="thesis__bed" aria-hidden="true"></div>
  <div class="sl-wrap thesis__grid">
    <div class="thesis__head">
      <div class="sl-section__head">
        <span class="sl-section__idx">01</span>
        <span class="sl-eyebrow">The stance</span>
      </div>
      <h2 class="h2">Tools that keep you in command of the machines working for you.</h2>
      <p class="lede">
        Sondalab builds software that{' '}
        <strong>runs, watches and improves</strong> the agents doing your work,
        and keeps them <strong>legible, controllable and yours</strong>. It's a
        stance that holds as machines grow more capable: from today's software
        agents toward the physical systems, and <strong>robotics</strong>, ahead.
      </p>
    </div>

    <ol class="triptych">
      {pillars.map((p, i) => (
        <li class="panel">
          <canvas class="sscene" data-dot-scene data-grid="130" data-src={p.scene.src} aria-hidden="true"></canvas>
          <span class="panel__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="panel__verb">{p.verb}</h3>
          <p class="panel__body" set:html={p.body}></p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* The bed: the band's soft gradient of blooms, no rules, generated from the
     kit's theme tokens by scripts/make-backdrops.mjs. */
  .thesis {
    position: relative;
    --bed: url('/backdrops/thesis-dark.svg');
  }
  :root[data-sl-theme='light'] .thesis {
    --bed: url('/backdrops/thesis-light.svg');
  }
  .thesis__bed {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: var(--bed) center / cover no-repeat;
  }

  .thesis__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }
  /* The head reads across: the claim on the left, the lede answering it. */
  @media (min-width: 52rem) {
    .thesis__head {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      column-gap: clamp(2rem, 5vw, 5rem);
      align-items: end;
    }
    .thesis__head .sl-section__head { grid-column: 1 / -1; }
  }
  .thesis__head .h2 { margin-top: 1.25rem; max-width: 18ch; }
  .thesis__head .lede { margin-top: 1.5rem; }
  .thesis__head .lede strong { font-weight: 600; color: var(--sl-bg-canvas); }

  /* Three panels side by side, divided by hairlines in the band's own ink,
     each led by its scene. Not cards: nothing is boxed. */
  .triptych {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
  }
  /* Between phone and wide: each pillar is a row, the scene beside its words,
     because three columns here would shrink the scenes below the ~280px a
     photo in dots needs to read (1024px gave 255px). */
  @media (min-width: 40rem) and (max-width: 71.99rem) {
    .panel {
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr);
      /* The text is one block, centred on the scene: two flexible rows
         around three that hug their content. */
      grid-template-rows: 1fr auto auto auto 1fr;
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }
    .panel > .sscene { grid-row: 1 / -1; margin-bottom: 0; }
    .panel__n { grid-column: 2; grid-row: 2; }
    .panel__verb { grid-column: 2; grid-row: 3; }
    .panel__body { grid-column: 2; grid-row: 4; }
  }
  @media (min-width: 72rem) {
    /* Each panel's four parts (vignette, number, verb, body) share the
       triptych's rows through subgrid, so the text lines up across the three
       columns even where a column is narrower. */
    .triptych {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: repeat(4, auto);
      gap: 0;
    }
    .panel {
      display: grid;
      grid-row: span 4;
      grid-template-rows: subgrid;
      align-content: start;
    }
    .sscene { align-self: end; }
    .panel { padding-inline: clamp(1.25rem, 2.5vw, 2.25rem); }
    .panel:first-child { padding-left: 0; }
    .panel:last-child { padding-right: 0; }
    .panel + .panel { border-left: 1px solid color-mix(in srgb, currentColor 16%, transparent); }
  }

  /* Big enough to read: a photo in dots needs room. It fills its column, up to
     320px. */
  .sscene {
    display: block;
    width: min(100%, 320px);
    aspect-ratio: 1;
    height: auto;
    margin-bottom: 1.5rem;
  }
  :root[data-sl-theme='high-contrast'] .sscene { display: none; }

  .panel__n {
    display: block;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--sl-bg-canvas) 76%, transparent);
  }
  .panel__verb {
    margin: 0.35rem 0 0.6rem;
    font-family: var(--sl-font-display);
    font-weight: 440;
    font-variation-settings: 'opsz' 72, 'WONK' 1;
    font-size: var(--step-h3);
    color: var(--sl-bg-canvas);
  }
  .panel__body {
    margin: 0;
    max-width: 38ch;
    color: color-mix(in srgb, var(--sl-bg-canvas) 76%, transparent);
  }
  .panel__body :global(strong) {
    font-weight: 600;
    color: var(--sl-bg-canvas);
  }
</style>

<script>
  import { mountDotScenes } from '../lib/dot-scene-runtime';
  mountDotScenes(document.getElementById('approach') ?? document);
</script>
