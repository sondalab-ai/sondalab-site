---
const pillars = [
  {
    verb: 'See it',
    body: 'Whatever a machine is doing, Sondalab keeps it legible — observable, measurable, understandable as it happens. No black boxes.',
  },
  {
    verb: 'Steer it',
    body: 'You stay in the loop and in charge: direct it, correct it, hand off or take the controls back at any moment. Assistance, never autopilot.',
  },
  {
    verb: 'Own it',
    body: 'The machine, its data and its off-switch stay yours — answering to you, running where you are, not to a service out of reach.',
  },
];
---

<section id="approach" class="section invert thesis">
  <div class="wrap thesis__grid">
    <div class="thesis__head">
      <div class="section-index">
        <span class="section-index__no">01</span>
        <span class="eyebrow">The stance</span>
      </div>
      <h2 class="h2">Tools that keep you in command of the machines working for you.</h2>
      <p class="lede">
        Sondalab builds software that runs, watches and improves the agents doing
        your work — and keeps them legible, controllable and yours. It's a stance
        that holds as machines grow more capable: from today's software agents
        toward the physical systems, and robotics, ahead.
      </p>
    </div>

    <ol class="thesis__pillars">
      {pillars.map((p, i) => (
        <li class="pillar">
          <span class="pillar__no">{String(i + 1).padStart(2, '0')}</span>
          <div class="pillar__body">
            <h3 class="pillar__verb">{p.verb}</h3>
            <p>{p.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .thesis__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  @media (min-width: 52rem) {
    .thesis__grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }
    .thesis__head {
      position: sticky;
      top: 6rem;
    }
  }
  .thesis__head .h2 { margin-top: 1.25rem; max-width: 16ch; }
  .thesis__head .lede { margin-top: 1.5rem; }

  .thesis__pillars {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pillar {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-top: 1px solid color-mix(in srgb, var(--sl-bg-canvas) 18%, transparent);
  }
  .pillar:first-child { border-top: 0; padding-top: 0; }

  .pillar__no {
    font-family: var(--sl-font-mono);
    font-weight: 100;
    font-size: var(--step-numeral);
    line-height: 0.8;
    color: color-mix(in srgb, var(--sl-bg-canvas) 30%, transparent);
  }
  .pillar__verb {
    font-family: var(--sl-font-display);
    font-weight: 440;
    font-variation-settings: 'opsz' 72, 'WONK' 1;
    font-size: var(--step-h3);
    margin: 0 0 0.5rem;
    color: var(--sl-bg-canvas);
  }
  .pillar__body p {
    margin: 0;
    max-width: 42ch;
    color: color-mix(in srgb, var(--sl-bg-canvas) 76%, transparent);
  }
</style>
