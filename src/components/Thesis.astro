---
const pillars = [
  {
    verb: 'See it',
    body: 'Whatever a machine is doing, Sondalab <strong>keeps it legible</strong>: observable, measurable, understandable as it happens. <strong>No black boxes.</strong>',
  },
  {
    verb: 'Steer it',
    body: 'You <strong>stay in the loop and in charge</strong>: direct it, correct it, hand off or take the controls back at any moment. <strong>Assistance, never autopilot.</strong>',
  },
  {
    verb: 'Own it',
    body: 'The machine, its data and <strong>its off-switch stay yours</strong>, answering to you, <strong>running where you are</strong>, not to a service out of reach.',
  },
];
---

<section id="approach" class="section invert thesis">
  <div class="thesis__bed" aria-hidden="true"></div>
  <div class="wrap thesis__grid">
    <div class="thesis__head">
      <div class="section-index">
        <span class="section-index__no">01</span>
        <span class="eyebrow">The stance</span>
      </div>
      <h2 class="h2">Tools that keep you in command of the machines working for you.</h2>
      <p class="lede">
        Sondalab builds software that{' '}
        <strong>runs, watches and improves</strong> the agents doing your work,
        and keeps them <strong>legible, controllable and yours</strong>. It's a
        stance that holds as machines grow more capable: from today's software
        agents toward the physical systems, and <strong>robotics</strong>, ahead.
      </p>
    </div>

    <ol class="thesis__pillars">
      {pillars.map((p, i) => (
        <li class="pillar sl-fx-glass sl-fx-glass--pane">
          <span class="pillar__no">{String(i + 1).padStart(2, '0')}</span>
          <div class="pillar__body">
            <h3 class="pillar__verb">{p.verb}</h3>
            <p set:html={p.body}></p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* The bed. A pane laid on a flat slab shows nothing — it has no structure
     to blur and no colour to carry — so the band gets a field of soft blooms
     in the brand pair for the glass to read. Painted first and left under the
     content, which is what puts it in each pane's backdrop. */
  .thesis { position: relative; }
  .thesis__bed {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(58% 52% at 16% 20%,
        color-mix(in srgb, var(--sl-accent-default) 34%, transparent) 0%, transparent 70%),
      radial-gradient(48% 58% at 88% 36%,
        color-mix(in srgb, var(--sl-accent-depth) 30%, transparent) 0%, transparent 72%),
      radial-gradient(66% 48% at 54% 98%,
        color-mix(in srgb, var(--sl-accent-default) 18%, transparent) 0%, transparent 76%);
  }
  /* A ruled measure over the blooms: the blur needs an edge to bend, and a
     field of pure gradients blurs into itself. Faded top and bottom so the
     rules never meet the band's own boundary. */
  .thesis__bed::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to right,
      color-mix(in srgb, var(--sl-bg-canvas) 8%, transparent) 0 1px,
      transparent 1px 4.5rem);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 22%, black 78%, transparent);
    mask-image: linear-gradient(to bottom, transparent, black 22%, black 78%, transparent);
  }

  .thesis__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  @media (min-width: 52rem) {
    .thesis__grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }
    .thesis__head {
      position: sticky;
      top: 6rem;
    }
  }
  .thesis__head .h2 { margin-top: 1.25rem; max-width: 16ch; }
  .thesis__head .lede { margin-top: 1.5rem; }

  .thesis__pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.85rem, 2vw, 1.4rem);
  }
  .pillar {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    --slg-radius: var(--sl-radius-lg);
  }

  .pillar__no {
    font-family: var(--sl-font-mono);
    font-weight: 100;
    font-size: var(--step-numeral);
    line-height: 0.8;
    color: color-mix(in srgb, var(--sl-bg-canvas) 30%, transparent);
  }
  .pillar__verb {
    font-family: var(--sl-font-display);
    font-weight: 440;
    font-variation-settings: 'opsz' 72, 'WONK' 1;
    font-size: var(--step-h3);
    margin: 0 0 0.5rem;
    color: var(--sl-bg-canvas);
  }
  .pillar__body p {
    margin: 0;
    max-width: 42ch;
    color: color-mix(in srgb, var(--sl-bg-canvas) 76%, transparent);
  }
  .thesis__head .lede strong,
  .pillar__body :global(strong) {
    font-weight: 600;
    color: var(--sl-bg-canvas);
  }
</style>
