---
// The kit's own faces, served from the package (no third-party CDN, GDPR-clean
// on .eu): Geist and Geist Mono for the UI, display included, and Fraunces for
// the wordmark alone (--sl-font-brand, ui-kit 0.30).
import '@sondalab/ui-kit/fonts.css';

// Design system, Tier A (Page substrate): tokens + both themes + components,
// then the two opt-in layers above them — the glass material and the effects.
//
// ORDER IS LOAD-BEARING and scripts/motion-gate.mjs enforces it: tokens.css
// zeroes --sl-motion-* under prefers-reduced-motion, and site.css restores
// them unconditionally, so site.css must stay last. effects.css goes after
// components.css because it composes onto the shipped .sl-* classes and never
// replaces them.
import '@sondalab/ui-kit/tokens.css';
import '@sondalab/ui-kit/themes/light.css';
import '@sondalab/ui-kit/themes/dark.css';
import '@sondalab/ui-kit/components.css';
import '@sondalab/ui-kit/glass.css';
import '@sondalab/ui-kit/effects.css';

import '../styles/site.css';
import { SITE } from '../lib/site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Sondalab builds local, legible tools for operators: the people who run agents, see every step, and own the machine.',
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.claim}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-sl-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} · Transmissions`}
      href="/rss.xml"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Set theme before paint: stored choice → OS preference → dark default. */}
    <script>
      // Tier 1 of the effects layer, armed once for every page. Tier 0 — the
      // glass material and the aurora's static arc on focus — is the CSS alone
      // and is already correct without this; mount() adds the motion.
      //
      // ignoreReducedMotion: this site's documented decision, now expressed
      // through the kit instead of by keeping a driver of its own. Windows
      // reports `reduce` by default under "adjust for best performance", and
      // the glitch here is brand, not decoration. scripts/motion-gate.mjs
      // still guards it. The derogation reaches the glitch and the halftone
      // vignettes' motion; high contrast refuses regardless.
      //
      // bursts: the ambient ceiling. The hero claim, both interlude markers
      // and a product name all burst on their own timers, and at the default
      // of 1 most of them would simply be dropped.
      import { mount } from '@sondalab/ui-kit/effects.js';
      mount(document, { ignoreReducedMotion: true, bursts: 3 });

      // The numerals are glass cut to their own letterforms: mount() arms
      // `sl-fx-glass--text`, measures the mask off the rendered type and seats
      // the light copy before each host.
    </script>

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('sl-theme');
          var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          var theme = stored || (prefersLight ? 'light' : 'dark');
          document.documentElement.setAttribute('data-sl-theme', theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    z-index: var(--sl-z-toast);
    background: var(--sl-accent-default);
    color: var(--sl-text-on-accent);
    padding: 0.5rem 1rem;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
  }
  .skip-link:focus { left: 0; }
</style>
