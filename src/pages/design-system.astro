---
// The design-system page. Nothing here is written by hand: components and
// effects come from the kit's agent/catalog.md (rendered live with the real
// kit CSS, prose and code beside each), tokens from tokens.css and the themes,
// the version from the package. A kit bump changes the page; no file in this
// repo does.
//
// Opt-in stylesheets the rest of the site does not load are imported here,
// one line each: the workbench chrome (palette, tree, status bar) and the
// high-contrast theme the per-demo switch offers. The effects layer
// (effects.css, glass.css) and its mount() come from Base.
// scripts/kit-catalog.test.mjs fails if the catalog names a stylesheet that
// neither this page nor Base imports.
import '@sondalab/ui-kit/workbench.css';
import '@sondalab/ui-kit/themes/high-contrast.css';
import halftoneSrc from '@sondalab/ui-kit/assets/avatar-ink.png?url';
import Base from '../layouts/Base.astro';
import { assertUniqueIds, loadKitCatalog, loadKitTokens, proseParts, specimen } from '../lib/kit-catalog';

const { sections, json } = loadKitCatalog();
const { version, groups } = loadKitTokens();

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const short = (title: string) => title.replace(/\s*\(.*$/, '');
const anchors = sections.map((s) => slug(short(s.title)));
if (new Set(anchors).size !== anchors.length || anchors.includes(''))
  throw new Error(`catalog section anchors are not unique: ${anchors.join(', ')}`);

// Entry ids: stable, unique, and clear of the page's own anchors.
const used = new Set<string>(['tokens', 'contrast', ...anchors]);
const entryId = (title: string) => {
  const base = `c-${slug(title)}`;
  let id = base;
  for (let n = 2; used.has(id); n++) id = `${base}-${n}`;
  used.add(id);
  return id;
};
const ids = new Map(sections.flatMap((s) => s.entries).map((e) => [e, entryId(e.title)]));
assertUniqueIds(sections, [...used]);

// On-brand figure image: the kit's own halftone mark, in place of a grey box.
const assets = { image: halftoneSrc, halftone: halftoneSrc };

// An effect needs light and a ground to act on: its specimen gets a backdrop,
// and nothing clips its bloom. Which entries are effects is the kit's own index.
const effectClasses = new Set(json.components.filter((c) => c.kind === 'effect').flatMap((c) => c.classes));
const isEffect = (classes: string[]) => classes.some((c) => effectClasses.has(c));
// The names to show: the component's classes, not its modifiers or elements.
const names = (classes: string[]) => classes.filter((c) => !c.startsWith('--') && !c.startsWith('__') && !c.startsWith('+')).join(' ');

// What a specimen cannot show on its own, said once beside it.
const NOTES: [RegExp, string][] = [
  [/\bsl-spectral\b/, 'The spectral ink is painted in the light theme only: the spectrum tokens are undefined in dark by design, so there the text keeps its plain ink. Use the Light switch above to see it.'],
];
const SECTION_NOTES: Record<string, string> = {
  workbench: 'Workbench components are desktop chrome: they keep their width and scroll sideways on a narrow screen instead of collapsing.',
  effects: 'Every effect stills under prefers-reduced-motion (the goo drift is refused outright and the field stays welded), and [data-sl-fx="off"] or the high-contrast theme switches the layer off for a subtree.',
};
const workbenchAt = sections.findIndex((x) => /^Workbench/.test(x.title));

const count = sections.reduce((n, s) => n + s.entries.length, 0);
const tokenCount = groups.reduce((n, g) => n + g.tokens.length, 0);
---

<Base
  title="Design system"
  description="The Sondalab UI kit: tokens, components and effects, rendered live from the package this site is built with."
>
  <div class="ds sl-wrap">
    <header class="ds-head">
      <p class="sl-eyebrow">Design system</p>
      <h1>
        Sondalab UI kit
        <a class="ds-ver" href={`https://www.npmjs.com/package/@sondalab/ui-kit/v/${version}`} rel="noopener">v{version}</a>
      </h1>
      <p class="ds-lede">
        {count} entries (components, effects and patterns; a component with several demos counts once) and {tokenCount}
        tokens, drawn by the kit's own CSS. This page is generated from the package installed at build time, so it is
        always the version this site runs.
      </p>
    </header>

    <div class="ds-layout">
      <aside class="ds-nav" aria-label="On this page">
        <label class="ds-filter">
          <span class="ds-vh">Filter components</span>
          <input class="sl-field__input" type="search" placeholder="Filter components…" data-ds-filter autocomplete="off" />
        </label>
        <p class="ds-count" data-ds-count aria-live="polite"></p>
        <ul class="ds-toc">
          <li><a href="#tokens" data-ds-spy>Tokens</a></li>
          <li><a href="#contrast" data-ds-spy>Contrast</a></li>
          {sections.map((s, i) => (
            <li>
              <a href={`#${anchors[i]}`} data-ds-spy>{short(s.title)}</a>
              <ul>
                {s.entries.map((e) => (
                  <li data-ds-toc-entry={ids.get(e)}><a href={`#${ids.get(e)}`} data-ds-spy>{e.title}</a></li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </aside>

      <div class="ds-main">
        <section id="tokens" class="ds-sec">
          <h2>Tokens</h2>
          <p class="ds-note">
            Click a row to copy <code>var(--token)</code>. Colour tokens show their value in both themes; a theme that
            leaves one undefined says so.
          </p>
          {groups.map((g) => (
            <div class="ds-fam">
              <h3>{g.family}</h3>
              <ul class="ds-tokens">
                {g.tokens.map((t) => (
                  <li data-ds-token={t.name}>
                    <button class="ds-row" type="button" data-ds-copy={`var(${t.name})`} title={`Copy var(${t.name})`}>
                      <span class="ds-prev" aria-hidden="true">
                        {t.kind === 'colour' && (
                          <>
                            <span class="ds-sw" data-sl-theme="light" style={`background:var(${t.name})`} />
                            <span class="ds-sw" data-sl-theme="dark" style={`background:var(${t.name})`} />
                          </>
                        )}
                        {t.kind === 'space' && <span class="ds-bar" style={`width:var(${t.name})`} />}
                        {t.kind === 'radius' && <span class="ds-rad" style={`border-radius:var(${t.name})`} />}
                        {t.kind === 'size' && <span class="ds-ag" style={`font-size:var(${t.name})`}>Ag</span>}
                        {t.kind === 'font' && <span class="ds-fox" style={`font-family:var(${t.name})`}>The quick brown fox 0123</span>}
                        {t.kind === 'line' && <span class="ds-lines" style={`line-height:var(${t.name})`}>Line height<br />sets the rhythm<br />of running text</span>}
                        {t.kind === 'shadow' && (
                          <>
                            <span class="ds-ground" data-sl-theme="light"><span class="ds-shadow" style={`box-shadow:var(${t.name})`} /></span>
                            <span class="ds-ground" data-sl-theme="dark"><span class="ds-shadow" style={`box-shadow:var(${t.name})`} /></span>
                          </>
                        )}
                        {t.kind === 'motion' && <span class="ds-motion" style={`--ds-dur:var(${t.name})`} data-motion={t.value} />}
                        {t.kind === 'focus' && <span class="ds-focus" style={`outline-width:var(${t.name})`} />}
                      </span>
                      <code class="ds-name">{t.name}</code>
                      {t.themed && t.kind === 'colour' ? (
                        <span class="ds-vals">
                          <span class="ds-val" data-ds-val="light">light: …</span>
                          <span class="ds-val" data-ds-val="dark">dark: …</span>
                        </span>
                      ) : (
                        <span class="ds-vals">
                          <span class="ds-val" title={t.value}>{t.value ?? 'differs per theme'}</span>
                        </span>
                      )}
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>

        <section id="contrast" class="ds-sec">
          <h2>Contrast</h2>
          <p class="ds-note">
            Measured in your browser from the live tokens, in each theme, against WCAG 2: 4.5:1 for text (AA), 7:1 for AAA,
            3:1 for non-text.
          </p>
          <div class="ds-tablewrap">
            <table class="ds-contrast" data-ds-contrast>
              <thead>
                <tr><th scope="col">Ink on ground</th><th scope="col">Light</th><th scope="col">Dark</th></tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </section>

        {sections.map((s, i) => (
          <section id={anchors[i]} class="ds-sec" data-ds-section>
            <h2>{short(s.title)}</h2>
            {SECTION_NOTES[anchors[i].split('-')[0]] && <p class="ds-note">{SECTION_NOTES[anchors[i].split('-')[0]]}</p>}
            {s.entries.map((e) => {
              const { lead, rest } = proseParts(e.prose);
              const note = NOTES.find(([re]) => re.test(e.classes.join(' ')))?.[1];
              return (
                <article class="ds-entry" id={ids.get(e)} data-ds-entry data-ds-name={`${e.title} ${names(e.classes)}`.toLowerCase()}>
                  <h3>
                    {e.title} <code>{names(e.classes)}</code>
                    <a class="ds-perma" href={`#${ids.get(e)}`} aria-label={`Link to ${e.title}`}>#</a>
                    <span class="ds-themes" role="group" aria-label={`Theme for the ${e.title} demo`}>
                      {['auto', 'light', 'dark', 'high-contrast'].map((t) => (
                        <button type="button" data-ds-theme={t} aria-pressed={t === 'auto' ? 'true' : 'false'}>
                          {t === 'high-contrast' ? 'Contrast' : t[0].toUpperCase() + t.slice(1)}
                        </button>
                      ))}
                    </span>
                  </h3>
                  {lead && <div class="ds-lead" set:html={lead} />}
                  {note && <p class="ds-note">{note}</p>}
                  {e.snippets.map((html) => (
                    <>
                      <div class:list={['ds-spec', { 'ds-spec--fx': isEffect(e.classes), 'ds-spec--wide': i === workbenchAt }]} set:html={specimen(html, assets)} />
                      <details class="ds-code">
                        <summary>Markup</summary>
                        <button class="sl-btn sl-btn--ghost sl-btn--sm ds-copycode" type="button" data-ds-copy-code>Copy</button>
                        <pre><code>{html}</code></pre>
                      </details>
                    </>
                  ))}
                  {rest && (
                    <details class="ds-usage">
                      <summary>Usage, tokens and rules</summary>
                      <div set:html={rest} />
                    </details>
                  )}
                </article>
              );
            })}
          </section>
        ))}
      </div>
    </div>

    <button class="sl-btn sl-btn--ghost ds-top" type="button" data-ds-top hidden>Back to top</button>
    <div class="ds-toast sl-toast" role="status" aria-live="polite" data-ds-toast hidden></div>
  </div>
</Base>

<script>
  // Specimens are not a site: placeholder links stay put, and a glitch fires
  // on a real event, as the kit asks (CSS alone renders nothing).
  import { burst } from '@sondalab/ui-kit/effects.js';

  const $$ = <T extends Element>(sel: string, root: ParentNode = document) => [...root.querySelectorAll<T>(sel)];
  const toast = document.querySelector<HTMLElement>('[data-ds-toast]')!;
  let toastTimer = 0;
  const say = (msg: string) => {
    toast.textContent = msg;
    toast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (toast.hidden = true), 1600);
  };
  const copy = async (text: string, what: string) => {
    try {
      await navigator.clipboard.writeText(text);
      say(`Copied ${what}`);
    } catch {
      say('Copy is blocked in this browser');
    }
  };

  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (target.closest('.ds-spec a[href="#"]')) e.preventDefault();
    const glitch = target.closest('.ds-spec .sl-fx-glitch');
    if (glitch) burst(glitch);

    const row = target.closest<HTMLElement>('[data-ds-copy]');
    if (row) copy(row.dataset.dsCopy!, row.dataset.dsCopy!);
    const code = target.closest<HTMLElement>('[data-ds-copy-code]');
    if (code) copy(code.closest('.ds-code')!.querySelector('code')!.textContent ?? '', 'markup');

    // Per-demo theme: set on the specimen, so one demo can be read in another theme.
    const themeBtn = target.closest<HTMLElement>('[data-ds-theme]');
    if (themeBtn) {
      const art = themeBtn.closest('article')!;
      const theme = themeBtn.dataset.dsTheme!;
      $$('.ds-spec', art).forEach((spec) => (theme === 'auto' ? spec.removeAttribute('data-sl-theme') : spec.setAttribute('data-sl-theme', theme)));
      $$<HTMLElement>('[data-ds-theme]', art).forEach((b) => b.setAttribute('aria-pressed', String(b === themeBtn)));
    }
  });

  // The kit's slider fills from --sl-slider-value, which its catalog markup
  // writes from an inline oninput. Specimens run no inline handlers, so the
  // page does the same write: once on load, then on every input.
  const fill = (el: HTMLInputElement) =>
    el.style.setProperty('--sl-slider-value', `${((+el.value - +el.min) / (+el.max - +el.min)) * 100}%`);
  $$<HTMLInputElement>('.ds-spec .sl-slider').forEach(fill);
  document.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.matches?.('.ds-spec .sl-slider')) fill(el);
  });

  // Token values, resolved by the browser per theme: a probe element carrying
  // the theme paints the token as its colour, and the computed colour is read
  // back. A token a theme leaves undefined reads as empty.
  const probe = (theme: string) => {
    const el = document.createElement('div');
    el.setAttribute('data-sl-theme', theme);
    el.style.cssText = 'position:absolute;visibility:hidden;pointer-events:none';
    document.body.appendChild(el);
    return el;
  };
  const resolve = (el: HTMLElement, name: string) => {
    if (!getComputedStyle(el).getPropertyValue(name).trim()) return '';
    el.style.color = '';
    el.style.color = `var(${name})`;
    return getComputedStyle(el).color;
  };
  const probes: Record<string, HTMLElement> = { light: probe('light'), dark: probe('dark') };
  $$<HTMLElement>('[data-ds-token]').forEach((li) => {
    const name = li.dataset.dsToken!;
    $$<HTMLElement>('[data-ds-val]', li).forEach((v) => {
      const theme = v.dataset.dsVal!;
      const val = resolve(probes[theme], name);
      v.textContent = val ? `${theme}: ${val}` : `${theme}: not defined`;
      v.classList.toggle('ds-val--none', !val);
    });
  });

  // Contrast: paint each colour on a canvas to get bytes whatever its syntax
  // (oklch, color-mix), then WCAG 2 arithmetic.
  const cv = document.createElement('canvas').getContext('2d', { willReadFrequently: true })!;
  const bytes = (css: string): [number, number, number] => {
    cv.canvas.width = cv.canvas.height = 1;
    cv.clearRect(0, 0, 1, 1);
    cv.fillStyle = '#000';
    cv.fillStyle = css;
    cv.fillRect(0, 0, 1, 1);
    const d = cv.getImageData(0, 0, 1, 1).data;
    return [d[0], d[1], d[2]];
  };
  const lum = ([r, g, b]: number[]) => {
    const f = (v: number) => ((v /= 255) <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);
  };
  const ratio = (a: string, b: string) => {
    const [x, y] = [lum(bytes(a)), lum(bytes(b))];
    return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
  };
  const PAIRS: [string, string, string][] = [
    ['--sl-text-primary', '--sl-bg-canvas', 'Primary text on canvas'],
    ['--sl-text-primary', '--sl-bg-surface', 'Primary text on surface'],
    ['--sl-text-secondary', '--sl-bg-canvas', 'Secondary text on canvas'],
    ['--sl-text-secondary', '--sl-bg-surface', 'Secondary text on surface'],
    ['--sl-text-muted', '--sl-bg-canvas', 'Muted text on canvas'],
    ['--sl-text-muted', '--sl-bg-surface', 'Muted text on surface'],
    ['--sl-text-on-accent', '--sl-accent-default', 'Text on accent'],
  ];
  const badge = (r: number) => (r >= 7 ? 'AAA' : r >= 4.5 ? 'AA' : r >= 3 ? 'non-text only' : 'fails');
  const tbody = document.querySelector('[data-ds-contrast] tbody')!;
  for (const [fg, bg, label] of PAIRS) {
    const tr = document.createElement('tr');
    const th = document.createElement('th');
    th.scope = 'row';
    th.textContent = `${label} `;
    const code = document.createElement('code');
    code.textContent = `${fg.slice(5)} / ${bg.slice(5)}`;
    th.appendChild(code);
    tr.appendChild(th);
    for (const t of ['light', 'dark']) {
      const f = resolve(probes[t], fg);
      const b = resolve(probes[t], bg);
      const td = document.createElement('td');
      if (f && b) {
        const r = ratio(f, b);
        td.textContent = `${r.toFixed(2)}:1 · ${badge(r)}`;
      } else td.textContent = 'not defined';
      tr.appendChild(td);
    }
    tbody.appendChild(tr);
  }
  Object.values(probes).forEach((p) => p.remove());

  // Filter: hides entries and their contents-links that do not match, and
  // sections left empty.
  const input = document.querySelector<HTMLInputElement>('[data-ds-filter]')!;
  const count = document.querySelector<HTMLElement>('[data-ds-count]')!;
  const entries = $$<HTMLElement>('[data-ds-entry]');
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const a of entries) {
      const hit = !q || a.dataset.dsName!.includes(q);
      a.hidden = !hit;
      document.querySelector<HTMLElement>(`[data-ds-toc-entry="${a.id}"]`)!.hidden = !hit;
      if (hit) shown++;
    }
    $$<HTMLElement>('[data-ds-section]').forEach((s) => (s.hidden = !!q && !$$('[data-ds-entry]:not([hidden])', s).length));
    count.textContent = q ? `${shown} of ${entries.length} entries` : '';
  });

  // Scroll-spy: the contents link of the section or entry in view.
  const links = new Map($$<HTMLAnchorElement>('[data-ds-spy]').map((a) => [a.getAttribute('href')!.slice(1), a]));
  const spy = new IntersectionObserver(
    (obs) => {
      for (const o of obs) {
        if (!o.isIntersecting) continue;
        links.forEach((a) => a.removeAttribute('aria-current'));
        links.get((o.target as HTMLElement).id)?.setAttribute('aria-current', 'true');
      }
    },
    { rootMargin: '-80px 0px -70% 0px' },
  );
  links.forEach((_, id) => {
    const target = document.getElementById(id);
    if (target) spy.observe(target);
  });

  const top = document.querySelector<HTMLButtonElement>('[data-ds-top]')!;
  addEventListener('scroll', () => (top.hidden = scrollY < 1200), { passive: true });
  top.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
</script>

<style is:global>
  .ds { padding-block: var(--sl-space-8); }
  .ds-head { margin-bottom: var(--sl-space-6); }
  .ds h1 { font-size: var(--sl-text-3xl); line-height: var(--sl-line-tight); margin: var(--sl-space-2) 0; }
  .ds-ver { font: var(--sl-text-md) var(--sl-font-mono); color: var(--sl-text-secondary); }
  .ds-lede { max-width: 60ch; color: var(--sl-text-secondary); }
  .ds-vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Contents rail from 64rem; a flow list above the page below it. */
  .ds-layout { display: grid; gap: var(--sl-space-6); }
  .ds-main { min-width: 0; }
  .ds-nav { font-size: var(--sl-text-sm); }
  .ds-nav ul { list-style: none; margin: 0; padding: 0; }
  .ds-toc > li > a { display: block; padding-block: 0.15rem; font-weight: 600; text-decoration: none; color: var(--sl-text-primary); }
  .ds-toc ul { padding-left: var(--sl-space-3); border-left: 1px solid var(--sl-border-subtle); margin-bottom: var(--sl-space-2); }
  .ds-toc ul a { display: block; padding-block: 0.1rem; text-decoration: none; color: var(--sl-text-secondary); }
  .ds-toc a:hover { color: var(--sl-text-primary); }
  .ds-toc a[aria-current="true"] { color: var(--sl-accent-text, var(--sl-accent-default)); }
  .ds-toc li[hidden] { display: none; }
  .ds-count { min-height: 1.2em; margin: var(--sl-space-2) 0; color: var(--sl-text-secondary); font-size: var(--sl-text-xs); }
  @media (max-width: 63.99rem) {
    .ds-toc ul { display: none; }
    .ds-toc { display: flex; flex-wrap: wrap; gap: var(--sl-space-2) var(--sl-space-4); }
  }
  @media (min-width: 64rem) {
    .ds-layout { grid-template-columns: 15rem minmax(0, 1fr); align-items: start; }
    .ds-nav { position: sticky; top: 5rem; max-height: calc(100vh - 6rem); overflow-y: auto; padding-right: var(--sl-space-3); }
  }

  .ds-sec { margin-top: var(--sl-space-8); scroll-margin-top: 5rem; }
  .ds-sec:first-child { margin-top: 0; }
  .ds-sec[hidden] { display: none; }
  .ds-sec > h2 { font-size: var(--sl-text-xl); margin-bottom: var(--sl-space-3); }
  .ds-note { max-width: 70ch; color: var(--sl-text-secondary); font-size: var(--sl-text-sm); margin: 0 0 var(--sl-space-4); }

  /* Tokens: one row = preview · name · value(s), the whole row a copy button. */
  .ds-fam { margin-bottom: var(--sl-space-6); }
  .ds-fam > h3 { font: 600 var(--sl-text-sm) var(--sl-font-sans); text-transform: capitalize; margin-bottom: var(--sl-space-2); }
  .ds-tokens { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--sl-border-subtle); }
  .ds-tokens li { border-bottom: 1px solid var(--sl-border-subtle); }
  .ds-row { all: unset; box-sizing: border-box; display: grid; grid-template-columns: 8.5rem minmax(0, 15rem) minmax(0, 1fr); align-items: center; gap: var(--sl-space-3); width: 100%; padding: var(--sl-space-2) var(--sl-space-1); cursor: pointer; font-size: var(--sl-text-sm); }
  .ds-row:hover { background: var(--sl-bg-surface); }
  .ds-row:focus-visible { outline: 2px solid var(--sl-focus-ring); outline-offset: -2px; }
  .ds-name { font: var(--sl-text-sm) var(--sl-font-mono); color: var(--sl-text-primary); overflow-wrap: anywhere; }
  .ds-vals { display: flex; flex-wrap: wrap; gap: 0 var(--sl-space-4); min-width: 0; }
  .ds-val { font: var(--sl-text-xs) var(--sl-font-mono); color: var(--sl-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
  .ds-val--none { font-style: italic; }
  @media (max-width: 40rem) {
    .ds-row { grid-template-columns: 5rem minmax(0, 1fr); }
    .ds-vals { grid-column: 1 / -1; }
  }
  .ds-prev { display: flex; align-items: center; gap: 4px; min-height: 2rem; overflow: hidden; }
  .ds-sw { width: 1.6rem; height: 1.6rem; border-radius: var(--sl-radius-sm); border: 1px solid var(--sl-border-default); }
  .ds-bar { display: block; height: 0.5rem; max-width: 100%; background: var(--sl-accent-default); border-radius: 1px; }
