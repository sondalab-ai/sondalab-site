---
// The ADS landing page: a real session first, then how a change lands, the
// benefits with their proof, the limits, and the install. The short product
// page (/products/ads/) links here. Content and the checked facts live in
// src/lib/ads-page.ts; this file is layout. Text in backticks there is shown
// in code font here.
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Transcript from '../components/Transcript.astro';
import AdsSessionCrt from '../components/AdsSessionCrt.astro';
import PrintHero from '../components/PrintHero.astro';
import heroPrint from '../assets/art/band-ads.webp';
import heroGround from '../assets/art/band-ground.webp';
import { markClass } from '../lib/marks';
import {
  ADS_BENEFITS,
  ADS_FIRST_RUN,
  ADS_HERO,
  ADS_INSTALL,
  ADS_LIMITS,
  ADS_PREREQS,
  ADS_RECIPES,
  ADS_STEPS,
  repoState,
} from '../lib/ads-page';

const entry = await getEntry('products', 'ads');
if (!entry) throw new Error('ads page: no product file src/content/products/ads.md');
const { notice, repoHref } = repoState(entry.data.repoPublic);
const ticks = (s: string) => s.split('`').map((text, i) => ({ text, code: i % 2 === 1 }));
const tail = ADS_BENEFITS.length;
---

<Base
  title="ADS — an agent team for your changes, in Claude Code"
  description="Say “fix #13” in Claude Code. An agent team writes tests, makes the change and reviews it in layers. A small, passing change of trivial, low or medium risk can land by itself, signed; high and critical wait for your ok <code>."
>
  <article class="ads">
    <header class="hero">
      <PrintHero print={heroPrint} ground={heroGround}>
        <p class="sl-eyebrow">{ADS_HERO.eyebrow}</p>
        <h1 class="sl-anchor">{ticks(ADS_HERO.h1).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</h1>
        <p class="hero__lede sl-prose">{ticks(ADS_HERO.lede).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</p>
        {notice && <p class="notice sl-badge sl-badge--info">{notice}</p>}
        <div class="actions">
          <a class="sl-btn sl-btn--primary" href="/ads/docs/getting-started/">Get started</a>
          <a class="sl-btn" href="/ads/docs/everyday-use/">Read the docs</a>
          {repoHref && <a class="sl-btn" href={repoHref}>Source on GitHub</a>}
        </div>
      </PrintHero>
    </header>

    <section id="session" class="sl-section session" aria-label="A session with ADS">
      <div class="sl-wrap">
        <AdsSessionCrt />
      </div>
    </section>

    <section id="how" class="sl-section">
      <div class="sl-wrap">
        <h2 class="big-h2">How a change lands, in four steps.</h2>
        <ol class="steps">
          {ADS_STEPS.map((s) => (
            <li class="sl-card step">
              <h3>{s.title}</h3>
              <p class="sl-prose">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {ADS_BENEFITS.map((b, i) => (
      <section id={b.id} class:list={['sl-section', i % 2 === 0 && 'sl-invert']}>
        <div class="sl-wrap">
          <div class="sl-section__head sec-head">
            <span class="sl-section__idx">{String(i + 1).padStart(2, '0')}</span>
            <p class={markClass(i)}>{b.kicker}</p>
          </div>
          <h2 class="big-h2">{b.h2}</h2>
          <div class="sec-body">
            {b.body.map((p) => <p class="sl-prose">{ticks(p).map((t) => (t.code ? <code>{t.text}</code> : t.text))}</p>)}
          </div>
          {b.table && (
            <div class="table-wrap">
              <table class="sl-table">
                <thead><tr>{b.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                <tbody>
                  {b.table.rows.map((row) => (
                    <tr>{row.map((cell) => <td>{ticks(cell).map((t) => (t.code ? <code>{t.text}</code> : t.text))}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </section>
    ))}

    <section id="limits" class="sl-section">
      <div class="sl-wrap">
        <div class="sl-section__head sec-head"><p class={markClass(tail)}>What it does not do</p></div>
        <h2 class="big-h2">The limits, plainly.</h2>
        <ul class="limits">
          {ADS_LIMITS.map((l) => <li>{ticks(l).map((t) => (t.code ? <code>{t.text}</code> : t.text))}</li>)}
        </ul>
      </div>
    </section>

    <section id="install" class="sl-section sl-invert">
      <div class="sl-wrap install">
        <div class="sl-section__head sec-head"><p class={markClass(tail + 1)}>Install</p></div>
        <h2 class="big-h2">Set it up once, then talk to Claude Code.</h2>
        <p class="sl-prose">{ADS_PREREQS}</p>
        <Transcript lines={ADS_INSTALL} label="Install commands: clone, make install, ads init, ads doctor" />
        <p class="sl-prose">{ticks(ADS_FIRST_RUN).map((t) => (t.code ? <code>{t.text}</code> : t.text))}</p>
        {notice && <p class="notice sl-badge sl-badge--info">{notice}</p>}
        <div class="actions">
          <a class="sl-btn sl-btn--primary" href="/ads/docs/getting-started/">Get started</a>
          {repoHref && <a class="sl-btn" href={repoHref}>Source on GitHub</a>}
        </div>
      </div>
    </section>

    <section id="recipes" class="sl-section">
      <div class="sl-wrap">
        <div class="sl-section__head sec-head"><p class={markClass(tail + 2)}>Everyday use</p></div>
        <h2 class="big-h2">What you can ask for.</h2>
        <ul class="recipes">
          {ADS_RECIPES.map((r) => <li><a class="sl-link" href={r.href}>{r.title} →</a></li>)}
        </ul>
      </div>
    </section>
  </article>
</Base>

<style>
  .ads {
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.075rem);
    line-height: var(--sl-line-relaxed);
  }
  .ads p.sl-eyebrow { margin: 0; }
  :where(.ads) :is(h1, h2, h3) {
    font-family: var(--sl-font-display);
    font-weight: 600;
    text-wrap: balance;
    letter-spacing: -0.02em;
    line-height: var(--sl-line-tight);
  }
  /* site.css paints prose code on the theme's surface, which an sl-invert band
     does not flip; a tint of the band's own text works in both. */
  .ads code {
    font-family: var(--sl-font-mono);
    font-size: 0.92em;
    color: inherit;
    background: color-mix(in srgb, var(--slc-text) 10%, transparent);
    padding: 0.1em 0.35em;
    border-radius: var(--sl-radius-sm);
    overflow-wrap: anywhere;
  }

  /* ---- hero ------------------------------------------------------------- */
  .hero :global(.ph__text) { display: grid; gap: var(--sl-space-5); justify-items: start; }
  .hero h1 { max-width: 24ch; margin: 0; font-size: clamp(2rem, 1.3rem + 3vw, 3.6rem); }
  .hero__lede { max-width: 62ch; margin: 0; color: var(--slc-text-secondary); font-size: clamp(1.05rem, 1rem + 0.4vw, 1.24rem); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--sl-space-3); }
  .notice { margin: 0; }

  /* ---- the session ------------------------------------------------------- */
  .ads > .sl-section { position: relative; padding-block: clamp(var(--sl-space-8), 7vw, 6rem); }

  /* ---- sections ---------------------------------------------------------- */
  .sec-head { flex-wrap: wrap; margin-bottom: var(--sl-space-6); }
  .big-h2 { max-width: 24ch; font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.6rem); margin: 0 0 var(--sl-space-5); }
  .sec-body { display: grid; gap: var(--sl-space-3); max-width: 62ch; margin-bottom: clamp(1.6rem, 3vw, 2.4rem); }
  .sec-body p { margin: 0; }

  .steps { display: grid; gap: var(--sl-space-4); margin: 0; padding: 0; list-style: none; counter-reset: step; }
  @media (min-width: 900px) { .steps { grid-template-columns: repeat(4, 1fr); } }
  .step { display: grid; align-content: start; gap: var(--sl-space-2); counter-increment: step; min-width: 0; }
  .step::before { content: counter(step, decimal-leading-zero); font-family: var(--sl-font-mono); color: var(--slc-accent-text); font-weight: 600; }
  .step h3 { margin: 0; font-size: 1.2rem; }
  .step p { margin: 0; }

  /* A wide table scrolls in its own box, never the page. */
  .table-wrap { overflow-x: auto; max-width: 100%; }
  .table-wrap :global(.sl-table) { min-width: 32rem; }

  .limits, .recipes { display: grid; gap: var(--sl-space-3); max-width: 62ch; margin: 0; padding-left: 1.2em; }
  .recipes { list-style: none; padding-left: 0; }

  .install { display: grid; gap: var(--sl-space-5); justify-items: start; }
  .install > * { margin: 0; }
  .install :global(.transcript) { width: 100%; max-width: 48rem; }
</style>
