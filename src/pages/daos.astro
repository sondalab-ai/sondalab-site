---
// "Asking twice": the DAOS research note. DAOS is presented as what it is, a
// research bench: what was measured, what did not pay off, and when it is not
// needed. The short product page (/products/daos/) links here.
//
// The one page on the site in four languages. English is rendered on the
// server; the script below swaps every data-i18n run (DaosText) for the
// visitor's language. The dictionary and the language rule are
// src/lib/daos-i18n.ts. Source titles and code stay as written.
//
// DAOS has no accent of its own: the kit's registry has `daos: { inherits:
// "default" }`, so the page paints in the site's default accent and needs no
// per-product repaint (compare products/[slug].astro).
import Base from '../layouts/Base.astro';
import DaosText from '../components/DaosText.astro';
import { DAOS_LANGS, DAOS_LANG_NAMES, type DaosKey } from '../lib/daos-i18n';
import { PAGE_POSTERS, PAGE_POSTER_SEEDS } from '../lib/posters';

// Excerpts: real output pasted from `uv run python` in the daos repo, real
// commands from its README, or (`exact`) the input rule shown on two requests.
// The `#` lines are ours, in plain words. Not translated: code reads the same
// in every language.
const ARTIFACTS = {
  audit: `<span class="c"># read back a logged run: the signature checks out</span>
read_run("ticket-01...")  <span class="c">→</span> <span class="ok">MAC-verified ✓</span>
<span class="c"># someone edits the stored answer by hand (billing → refund), read again:</span>
  <span class="c">→</span> <span class="no">IntegrityError: event 'ticket-01...'/1 failed HMAC verification</span>`,
  exact: `<span class="c"># the same request: only the layout of the JSON differs</span>
{"question":"Refund?","plan":"annual"}
{ "plan": "annual", "question": "Refund?" }      <span class="c">→</span> <span class="ok">same request, stored answer</span>
<span class="c"># a new request: one capital letter differs inside the text</span>
{"question":"refund?","plan":"annual"}           <span class="c">→</span> <span class="no">new request, new model call</span>`,
  fix: `<span class="c"># check stored answers every day (03:30 by default)</span>
uv run daos-inspect schedule install --config <span class="k">inspector.toml</span>
<span class="c"># withdraw or replace one stored answer, saying why</span>
uv run python scripts/admin/quarantine.py apply daos-cache.sqlite <span class="k">KEY</span> \\
  --reason <span class="k">"wrong capital"</span> --replacement-file <span class="k">fixed.json</span> ...`,
} as const;

const GLANCE: { value: string; note: DaosKey }[] = [
  { value: '20&rarr;1', note: 'glance.n1' },
  { value: '0', note: 'glance.n2' },
  { value: '33.2%', note: 'glance.n3' },
  { value: '0.978', note: 'glance.n4' },
];

const CAUSES: DaosKey[] = ['p.li1', 'p.li2', 'p.li3', 'p.li4'];

const STEPS: DaosKey[] = ['b.s1', 'b.s2', 'b.s3', 'b.s4'];

type Metric = { value: string; unit: string; note: DaosKey };

const FIRST: Metric[] = [
  { value: '20', unit: '&rarr;1', note: 'f.n1' },
  { value: '5', unit: '&nbsp;/ 5', note: 'f.n2' },
];

const VOTE: Metric[] = [
  { value: '9', unit: '&nbsp;/ 40', note: 'v.n1' },
  { value: '600', unit: '', note: 'v.n2' },
];

/** Spec ideas, not product: each card's `c` line says whether it is built or measured. */
const BRAIN: { from: DaosKey; h: DaosKey; p: DaosKey; c: DaosKey }[] = [
  { from: 'brain.from1', h: 'brain.h3a', p: 'brain.p1', c: 'brain.c1' },
  { from: 'brain.from2', h: 'brain.h3b', p: 'brain.p2', c: 'brain.c2' },
  { from: 'brain.from3', h: 'brain.h3c', p: 'brain.p3', c: 'brain.c3' },
];

const WORTH: DaosKey[] = ['u.y1', 'u.y2', 'u.y3'];
const NOT_WORTH: DaosKey[] = ['u.n1', 'u.n2', 'u.n3', 'u.n4'];

const OPEN: { h: DaosKey; p: DaosKey }[] = [
  { h: 'o.h3a', p: 'o.pa' },
  { h: 'o.h3b', p: 'o.pb' },
  { h: 'o.h3c', p: 'o.pc' },
  { h: 'o.h3d', p: 'o.pd' },
];

// Cited as [n] in the text. Titles stay in their original language.
const SOURCES: { by: string; title: string; where: string; href: string }[] = [
  {
    by: 'Horace He, Thinking Machines Lab',
    title: 'Defeating Nondeterminism in LLM Inference',
    where: 'September 2025',
    href: 'https://thinkingmachines.ai/blog/defeating-nondeterminism-in-llm-inference/',
  },
  {
    by: 'Fiona Lau',
    title: 'Same Input, Different Scores: A Multi Model Study on the Inconsistency of LLM Judge',
    where: 'arXiv 2603.04417',
    href: 'https://arxiv.org/abs/2603.04417',
  },
];
---

<Base
  title="Asking twice — a DAOS research note"
  description="What it takes to get the same answer from an AI model: what we built, what we measured, what did not pay off, and when you do not need any of it."
>
  <div class="daos" data-daos>
    {/* Arms the scroll reveal before the first paint, so the vote card never
        shows, hides, then rises. Without JavaScript nothing is armed and
        everything is simply visible. If the page script never runs, the timer
        disarms it; the script marks itself live to keep the arm. */}
    <script is:inline>
      (function (root) {
        if (!('IntersectionObserver' in window)) return;
        root.setAttribute('data-armed', '');
        setTimeout(function () {
          if (!root.hasAttribute('data-live')) root.removeAttribute('data-armed');
        }, 3000);
      })(document.currentScript.parentElement);
    </script>

    <div class="daos-bar">
      <div class="sl-wrap daos-bar__in">
        <p class="daos-brand">
          <svg class="daos-brand__mark" viewBox="0 0 40 40" aria-hidden="true">
            <path fill="currentColor" fill-rule="evenodd" d="M0 0h40v40H0z M9 11h22v4.2H9z M9 17.9h22v4.2H9z M9 24.8h22v4.2H9z" />
          </svg>
          <span class="daos-brand__name">DAOS</span>
        </p>
        <span class="sl-eyebrow daos-bar__meta">Deterministic Agent Output System</span>
        <div class="sl-segmented daos-lang" role="group" aria-label="Language">
          {DAOS_LANGS.map((l) => (
            <button
              class="sl-segmented__item"
              type="button"
              data-daos-lang={l}
              lang={l}
              aria-pressed={l === 'en' ? 'true' : 'false'}
            >{DAOS_LANG_NAMES[l]}</button>
          ))}
        </div>
      </div>
    </div>

    <!-- HERO -->
    <div class="sl-wrap">
      <div class="hero">
        <div class="hero-grid">
          <div>
            <DaosText as="p" class="sl-eyebrow" k="hero.kicker" />
            <DaosText as="h1" class="sl-anchor" k="hero.h1" />
            <DaosText as="p" class="hero-sub" k="hero.sub" />
            <DaosText as="p" class="hero-lede sl-prose" k="hero.lede" />
          </div>
          <div class="hero-side">
            <div class={`hero-poster ${PAGE_POSTERS.daos}`} data-sl-art-seed={PAGE_POSTER_SEEDS.daos} aria-hidden="true"></div>
            <aside class="sl-card glance sl-art-corner">
              <DaosText as="p" class="glance__cap" k="glance.cap" />
              <dl class="glance__list">
                {GLANCE.map((g) => (
                  <div class="glance__row">
                    <dt class="glance__value" set:html={g.value} />
                    <DaosText as="dd" class="glance__note" k={g.note} />
                  </div>
                ))}
              </dl>
            </aside>
          </div>
        </div>
      </div>
    </div>

    <!-- 01 · THE PROBLEM -->
    <section class="sl-section">
      <div class="sec-bed sl-art-field sl-art-field--fade-end" aria-hidden="true"></div>
      <div class="sl-wrap">
        <div class="sl-section__head sec-head"><span class="sl-section__idx">01</span><DaosText as="p" class="sl-eyebrow sl-eyebrow--mark" k="p.kicker" /></div>
        <DaosText as="h2" class="big-h2" k="p.h2" />
        <div class="two-col">
          <div>
            <DaosText as="p" class="lead-para sl-prose" k="p.p1" />
            <DaosText as="p" class="sl-prose" k="p.p2" />
          </div>
          <div>
            <DaosText as="p" class="sl-prose" k="p.why" />
            <ul class="layers">
              {CAUSES.map((k, i) => (
                <li class="stays"><span class="g">{i + 1}</span><DaosText k={k} /></li>
              ))}
            </ul>
            <DaosText as="p" class="note sl-prose" k="p.note" />
          </div>
        </div>
      </div>
    </section>

    <!-- 02 · FIRST FINDING -->
    <section class="sl-section sl-invert">
      <div class="sl-wrap">
        <div class="sl-section__head sec-head"><span class="sl-section__idx">02</span><DaosText as="p" class="sl-eyebrow sl-eyebrow--mark sl-eyebrow--mark-square" k="f.kicker" /></div>
        <DaosText as="h2" class="big-h2" k="f.h2" />
        <DaosText as="p" class="lead-para sl-prose block-lead" k="f.lead" />
        <div class="sl-hgrid metrics">
          {FIRST.map((m) => (
            <div class="sl-stat metric">
              <span class="sl-stat__value">{m.value}{m.unit && <small set:html={m.unit} />}</span>
              <DaosText as="p" class="metric-note" k={m.note} />
            </div>
          ))}
        </div>
        <DaosText as="p" class="foot-note" k="f.note" />
      </div>
    </section>

    <!-- 03 · WHAT WE BUILT -->
    <section class="sl-section">
      <div class="sl-wrap">
        <div class="sl-section__head sec-head"><span class="sl-section__idx">03</span><DaosText as="p" class="sl-eyebrow sl-eyebrow--mark sl-eyebrow--mark-tri" k="b.kicker" /></div>
        <DaosText as="h2" class="big-h2" k="b.h2" />
        <div class="two-col">
          <DaosText as="p" class="lead-para sl-prose" k="b.lead" />
          <div class="steps">
            {STEPS.map((k) => <DaosText as="p" class="note sl-prose" k={k} />)}
          </div>
        </div>
        <div class="excerpt">
          <DaosText class="sl-tag sl-tag--plain" k="b.tag" />
          <pre class="artifact sl-invert" set:html={ARTIFACTS.audit} />
        </div>
      </div>
    </section>

    <!-- 04 · THE EXACT-INPUT RULE -->
    <section class="sl-section">
      <div class="sec-bed sl-art-field sl-art-field--stripes sl-art-field--fade-end" aria-hidden="true"></div>
      <div class="sl-wrap">
        <div class="sl-section__head sec-head"><span class="sl-section__idx">04</span><DaosText as="p" class="sl-eyebrow sl-eyebrow--mark sl-eyebrow--mark-circle" k="r.kicker" /></div>
        <DaosText as="h2" class="big-h2" k="r.h2" />
        <div class="two-col">
          <DaosText as="p" class="lead-para sl-prose" k="r.p1" />
          <div>
            <DaosText as="p" class="note sl-prose" k="r.p2" />
            <DaosText as="p" class="note sl-prose" k="r.p3" />
          </div>
        </div>
        <div class="excerpt">
          <DaosText class="sl-tag sl-tag--plain" k="r.tag" />
          <pre class="artifact sl-invert" set:html={ARTIFACTS.exact} />
        </div>
      </div>
    </section>

    <!-- 05 · THE VOTE -->
    <section class="sl-section">
      <div class="sl-wrap">
        <div class="sl-section__head sec-head"><span class="sl-section__idx">05</span><DaosText as="p" class="sl-eyebrow sl-eyebrow--mark sl-eyebrow--mark-half" k="v.kicker" /></div>
        <DaosText as="h2" class="big-h2" k="v.h2" />
        <DaosText as="p" class="lead-para sl-prose block-lead" k="v.lead" />
        <div class="vote-grid">
          <figure class="sl-card proof research" aria-label="Three compressed copies of one model voting on one field; a two-to-one split decided by the majority">
            <div class="cap"><DaosText k="v.capA" /><DaosText k="v.capB" /></div>
            <DaosText as="p" class="leaf" k="v.leaf" />
            <div class="variants">
              <div class="vrow"><span class="q">F16</span><span class="raw">"high"</span></div>
              <div class="vrow"><span class="q">Q8_0</span><span class="raw">"high"</span></div>
              <div class="vrow"><span class="q">Q4_K_M</span><span class="raw">"medium" &nbsp;<DaosText class="lone" k="v.lone" /></span></div>
            </div>
            <DaosText as="div" class="collapse" k="v.collapse" />
            <div class="canon"><span class="q">OUTPUT</span><span class="out">"priority": "high"</span></div>
            <DaosText as="p" class="subnote" k="v.subnote" />
          </figure>
          <div class="sl-hgrid metrics metrics--stack">
            {VOTE.map((m) => (
              <div class="sl-stat metric">
                <span class="sl-stat__value">{m.value}{m.unit && <small set:html={m.unit} />}</span>
                <DaosText as="p" class="metric-note" k={m.note} />
              </div>
            ))}
          </div>
        </div>
        <DaosText as="p" class="sl-prose result-para" k="v.result" />
        <div class="punch sl-invert">
          <DaosText as="p" k="v.lesson" />
        </div>
      </div>
    </section>

    <!-- 06 · BRAINS -->
    <section class="sl-section">
      <div class="sl-wrap">
        <div class="sl-section__head sec-head">
          <span class="sl-section__idx">06</span>
          <DaosText as="p" class="sl-eyebrow sl-eyebrow--mark sl-eyebrow--mark-stair" k="brain.kicker" />
          <DaosText class="sl-tag" k="ui.notBuilt" />
        </div>
        <DaosText as="h2" class="big-h2" k="brain.h2" />
        <DaosText as="p" class="lead-para sl-prose block-lead" k="brain.lead" />
        <div class="sl-hgrid brain-grid">
          {BRAIN.map((b) => (
            <div class="bcard">
              <DaosText as="p" class="from" k={b.from} />
              <DaosText as="h3" k={b.h} />
              <DaosText as="p" k={b.p} />
              <DaosText as="p" class="constraint" k={b.c} />
            </div>
          ))}
          <div class="bcard rejected sl-invert">
            <DaosText as="p" class="from" k="brain.from4" />
            <DaosText as="h3" k="brain.h3d" />
            <DaosText as="p" k="brain.p4" />
            <DaosText as="p" class="tagline" k="brain.tagline" />
          </div>
        </div>
      </div>
    </section>

    <!-- 07 · CHECK AND FIX -->
    <section class="sl-section">
      <div class="sec-bed sl-art-field sl-art-field--grid sl-art-field--fade-end" aria-hidden="true"></div>
      <div class="sl-wrap">
        <div class="sl-section__head sec-head"><span class="sl-section__idx">07</span><DaosText as="p" class="sl-eyebrow sl-eyebrow--mark" k="w.kicker" /></div>
        <DaosText as="h2" class="big-h2" k="w.h2" />
        <DaosText as="p" class="lead-para sl-prose block-lead" k="w.lead" />
        <div class="sl-hgrid limits">
          <div class="limit"><DaosText as="h3" k="w.h3a" /><DaosText as="p" class="sl-prose" k="w.pa" /></div>
          <div class="limit"><DaosText as="h3" k="w.h3b" /><DaosText as="p" class="sl-prose" k="w.pb" /></div>
        </div>
        <div class="excerpt">
          <DaosText class="sl-tag sl-tag--plain" k="w.tag" />
          <pre class="artifact sl-invert" set:html={ARTIFACTS.fix} />
        </div>
      </div>
    </section>

    <!-- 08 · WHEN IT IS WORTH IT -->
    <section class="sl-section">
      <div class="sl-wrap">
        <div class="sl-section__head sec-head"><span class="sl-section__idx">08</span><DaosText as="p" class="sl-eyebrow sl-eyebrow--mark sl-eyebrow--mark-square" k="u.kicker" /></div>
        <DaosText as="h2" class="big-h2" k="u.h2" />
        <div class="sl-hgrid compare">
          <div class="col runtime">
            <DaosText class="sl-eyebrow" k="u.yes" />
            <ul class="fit">
              {WORTH.map((k) => <li class="fit--yes"><DaosText k={k} /></li>)}
            </ul>
          </div>
          <div class="col">
            <DaosText class="sl-eyebrow" k="u.no" />
            <ul class="fit">
              {NOT_WORTH.map((k) => <li class="fit--no"><DaosText k={k} /></li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 09 · OPEN QUESTIONS -->
    <section class="sl-section">
      <div class="sl-wrap">
        <div class="sl-section__head sec-head"><span class="sl-section__idx">09</span><DaosText as="p" class="sl-eyebrow sl-eyebrow--mark sl-eyebrow--mark-tri" k="o.kicker" /></div>
        <DaosText as="h2" class="big-h2" k="o.h2" />
        <div class="sl-hgrid limits">
          {OPEN.map((o) => (
            <div class="limit"><DaosText as="h3" k={o.h} /><DaosText as="p" class="sl-prose" k={o.p} /></div>
          ))}
        </div>
      </div>
    </section>

    <!-- CLOSE -->
    <section class="sl-section close">
      <div class="sec-bed sl-art-field sl-art-field--albers sl-art-field--fade-end" aria-hidden="true"></div>
      <div class="sl-wrap">
        <DaosText as="p" class="sl-eyebrow" k="close.kicker" />
        <DaosText as="h2" k="close.h2" />
        <DaosText as="p" class="lead-para sl-prose" k="close.lead" />
      </div>
    </section>

    <!-- SETUP AND SOURCES -->
    <section class="sl-section sources">
      <div class="sl-wrap">
        <DaosText as="p" class="sl-eyebrow" k="s.kicker" />
        <DaosText as="p" class="note sl-prose sources__setup" k="s.setup" />
        <ol class="sources__list">
          {SOURCES.map((s) => (
            <li>
              {s.by}, <a class="sl-link" href={s.href} rel="noopener">{s.title}</a>, {s.where}.
            </li>
          ))}
        </ol>
      </div>
    </section>

    <div class="daos-colophon">
      <div class="sl-wrap daos-colophon__in">
        <p class="sl-eyebrow">DAOS · Deterministic Agent Output System</p>
        <DaosText as="p" class="sl-eyebrow" k="footer.guarantee" />
      </div>
    </div>
  </div>
</Base>

<script>
  import {
    DAOS_I18N,
    DAOS_LANG_KEY,
    asDaosLang,
    resolveDaosLang,
    type DaosKey,
    type DaosLang,
  } from '../lib/daos-i18n';

  const page = document.querySelector<HTMLElement>('[data-daos]');
  const runs = document.querySelectorAll<HTMLElement>('[data-i18n]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-daos-lang]');

  /** Swaps every translatable run to `lang` and marks the switch; text only, no layout of its own. */
  function apply(lang: DaosLang) {
    const dict = DAOS_I18N[lang];
    for (const run of runs) {
      const html = dict[run.dataset.i18n as DaosKey];
      if (html !== undefined && run.innerHTML !== html) run.innerHTML = html;
    }
    document.documentElement.lang = lang;
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.daosLang === lang));
  }

  let stored: string | null = null;
  try {
    stored = localStorage.getItem(DAOS_LANG_KEY);
  } catch {
    // Storage blocked: the browser's language decides on every visit.
  }
  const preferred = navigator.languages?.length ? navigator.languages : [navigator.language];
  const initial = resolveDaosLang(stored, preferred);
  // The server already rendered English; only another language needs a pass.
  if (initial !== 'en') apply(initial);

  // Only an explicit pick is remembered, so a visitor who never chooses keeps
  // following the browser.
  for (const b of buttons) {
    b.addEventListener('click', () => {
      const lang = asDaosLang(b.dataset.daosLang);
      if (!lang) return;
      apply(lang);
      try {
        localStorage.setItem(DAOS_LANG_KEY, lang);
      } catch {
        // Not remembered; the choice still holds for this page view.
      }
    });
  }

  // Scroll reveal: the vote card's rows rise in as it enters the view. The inline script in the page armed the hidden state before the
  // first paint; claiming it here (data-live) keeps its fail-safe from undoing it.
  if (page?.hasAttribute('data-armed')) {
    page.setAttribute('data-live', '');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      },
      { threshold: 0.2, rootMargin: '0px 0px -8% 0px' },
    );
    for (const n of page.querySelectorAll('.proof')) io.observe(n);
  }
</script>


<style is:global>
  /* Global, under one .daos root: the translated runs arrive as markup
     (set:html on the server, innerHTML on a switch), and Astro's scoping
     attribute never reaches elements inside such markup, so scoped rules
     would silently miss the hero underline, the mono runs and the rest.

     Layout glue on --slc-* roles and --sl-* spacing/type tokens, no colour
     literal. Where the site's own globals (site.css) would leak in, the
     page's class names differ (.hero-lede, not .lede). */

  .daos {
    position: relative;
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.075rem);
    line-height: var(--sl-line-relaxed);
    letter-spacing: -0.006em;
  }
  .daos p.sl-eyebrow { margin: 0; }
  .daos .mono { font-family: var(--sl-font-mono); }
  .daos .ref { font-family: var(--sl-font-mono); font-size: 0.88em; white-space: nowrap; }
  /* Element weight only: `.daos h1` would outrank .sl-anchor and undo the
     display type's solid leading and tighter tracking, which the hero
     underline is measured against. */
  :where(.daos) :is(h1, h2, h3) {
    font-family: var(--sl-font-display);
    font-weight: 600;
    text-wrap: balance;
    letter-spacing: -0.02em;
    line-height: var(--sl-line-tight);
  }
  .daos b.ink { color: var(--slc-text); font-weight: 600; }
  .daos .mono.ink-2 { color: var(--slc-text-secondary); }

  /* ---- ruler gutter (L2, wide viewports only) -------------------------- */
  @media (min-width: 1080px) {
    .daos::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 1px;
      left: calc(var(--gutter) - 1px);
      background: var(--slc-border-subtle);
    }
  }

  /* ---- the DAOS bar, under the site's header ---------------------------- */
  .daos-bar { border-bottom: 1px solid var(--slc-border-subtle); }
  /* Wraps rather than squeezes: the switch names each language in itself, and
     where the row is too narrow for that it drops under the mark. */
  .daos-bar__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
