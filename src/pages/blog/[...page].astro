---
import type { GetStaticPaths, Page } from 'astro';
import Base from '../../layouts/Base.astro';
import CrtScene from '../../components/CrtScene.astro';
import uprisingFlat from '../../assets/scenes/uprising-flat.webp';
import uprisingFlatLight from '../../assets/scenes/uprising-flat-light.webp';
import { getPosts, readingTime, formatDate, isoDate, type Post } from '../../lib/blog';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return paginate(posts, { pageSize: 8 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;

const TITLE_BANDS = 6;
const titleShards = Array.from({ length: TITLE_BANDS }, (_, i) => i);

// Global, newest-first numbering that survives pagination: the oldest post is
// always // 01, so a transmission keeps its number as the archive grows.
const rows = page.data.map((post, i) => ({
  post,
  no: String(page.total - (page.start + i)).padStart(2, '0'),
  stamp: formatDate(post.data.date),
  iso: isoDate(post.data.date),
  mins: readingTime(post.body),
}));

// Every archive page, numbered: the count is measured, not estimated. Page 1
// lives at the archive root; the rest follow Astro's /blog/<n>/ shape.
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1);
const pageHref = (n: number) => (n === 1 ? '/blog/' : `/blog/${n}/`);

// Both readings of the same brief — machines against us, machines alongside us.
// The tube changes channel between them on a timer rather than one per archive
// page, so a visitor sees both without paging.
const BAND_SCENES = ['uprising', 'kinship'];
---

<Base
  title="Transmissions"
  description="Field notes from Sondalab on local-first agents, legible runs and the tooling that keeps an operator in the loop."
>
  <section class="tlog-page">
    {/* The archive opens on the transmission it lists. The tube is the head's
        own ground rather than a band between the head and the log: a full-bleed
        broadcast the title is read off, so the wordmark and the first row stay
        within one screen of each other. */}
    <div class="tlog-open">
      <div class="sl-wrap tlog-open__inner">
        <header class="tlog-head">
          <div class="tlog-head__title">
            <p class="sl-eyebrow">Transmissions</p>
            <h1
              class="tlog-head__h sl-fx-glitch sl-fx-glitch--shatter"
              data-text="Transmissions"
              style={`--slfx-n:${TITLE_BANDS}`}
            >
              <span class="sl-fx-glitch__text">Transmissions</span>
              <span class="sl-fx-glitch__shards" aria-hidden="true">
                {titleShards.map((i) => (
                  <span class="sl-fx-glitch__shard" style={`--slfx-i:${i}`}>Transmissions</span>
                ))}
              </span>
            </h1>
          </div>

          <div class="tlog-head__side">
            <label class="sl-field tsearch" data-tsearch-box hidden>
              <span class="sl-field__label">Filter</span>
              <input
                class="sl-field__input"
                id="tsearch"
                type="search"
                autocomplete="off"
                placeholder="// filter transmissions"
                data-tsearch
              />
            </label>
            <p class="tlog-count" data-tcount aria-live="polite">
              // {page.total} {page.total === 1 ? 'transmission' : 'transmissions'}
            </p>
          </div>
        </header>
      </div>
      {/* After the head in the document, behind it on screen: a screen reader
          reaches the archive's title before the scene that decorates it, and
          the tube's own position is set by the stylesheet either way. */}
      <CrtScene
        scene={BAND_SCENES}
        flat={uprisingFlat}
        flatLight={uprisingFlatLight}
        class="tlog-open__field"
        pointerHost=".tlog-open"
      />
    </div>

    <div class="sl-wrap">
      <ol class="tlog" data-tlist>
        {rows.map(({ post, no, stamp, iso, mins }) => (
          <li>
            <a class="trow" href={`/blog/${post.id}/`}>
              <span class="trow__stamp">
                <time class="trow__date" datetime={iso} data-num={stamp}>{stamp}</time>
                <span class="trow__no">// {no}</span>
              </span>
              <span class="trow__rule" aria-hidden="true"></span>
              <span class="trow__main">
                <span class="trow__title">{post.data.title}</span>
                <span class="trow__summary">{post.data.summary}</span>
              </span>
              <span class="trow__mins">{mins} min</span>
              <span class="trow__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>

      <ol class="tlog" data-tresults hidden></ol>

      {/* Blank row cloned by the filter. Rendered by Astro so the clones carry
          the same scoping attributes as the rows above, and so no result markup
          is ever built from a string. */}
      <template data-trow-template>
        <li>
          <a class="trow" href="">
            <span class="trow__stamp">
              <time class="trow__date" datetime=""></time>
              <span class="trow__no"></span>
            </span>
            <span class="trow__rule" aria-hidden="true"></span>
            <span class="trow__main">
              <span class="trow__title"></span>
              <span class="trow__summary"></span>
            </span>
            <span class="trow__mins"></span>
            <span class="trow__go" aria-hidden="true">→</span>
          </a>
        </li>
      </template>

      <p class="tlog-empty sl-empty sl-empty--void" data-tempty hidden>
        // no transmission matches that signal
      </p>

      {page.lastPage > 1 && (
        <nav class="sl-pagination tpager" aria-label="Archive pages" data-tpager>
          {page.url.prev ? (
            <a class="sl-pagination__item" href={page.url.prev} rel="prev">← Newer</a>
          ) : (
            <span class="sl-pagination__item tpager__off" aria-disabled="true">← Newer</span>
          )}
          {pageNumbers.map((n) => (
            <a
              class="sl-pagination__item"
              href={pageHref(n)}
              aria-current={n === page.currentPage ? 'page' : undefined}
            >{String(n).padStart(2, '0')}</a>
          ))}
          {page.url.next ? (
            <a class="sl-pagination__item" href={page.url.next} rel="next">Older →</a>
          ) : (
            <span class="sl-pagination__item tpager__off" aria-disabled="true">Older →</span>
          )}
        </nav>
      )}
    </div>
  </section>
</Base>

<style>
  .tlog-page { padding-block: 0 clamp(4rem, 8vw, 7rem); }

  /*
   * The head is read off the tube instead of standing above it. A band between
   * the two cost 490px at 1440x900 — a full screen of title and picture with no
   * transmission in it — and the archive is a log, not a poster.
   *
   * `--tube` is how much of the section sits above the first line of type. The
   * scrim keys off the same measure, so the picture runs clean where nothing is
   * read and the words get a ground exactly where they start.
   */
  .tlog-open {
    /* The measure follows the width as well as the height. Full-bleed, a height
       keyed to `vh` alone turns the tube into a slit as the screen widens: at
       3440px it ran at 9:1. The `vw` term keeps the aspect honest and the cap
       stops the picture from pushing the archive off the screen. */
    --tube: clamp(13rem, max(34vh, 17vw), 30rem);
    position: relative;
    isolation: isolate;
    padding-top: var(--tube);
  }
  /* `:global()` because the element is rendered by CrtScene.astro and carries
     that component's scope. Doubled with `.crt-scene` to beat the component's
     own `position: relative`, which would otherwise collapse the backdrop to
     zero height — everything inside it is absolutely positioned. */
  :global(.crt-scene.tlog-open__field) {
    position: absolute;
    /* Stops short of the section's foot rather than filling it. The tube frames
       its scene to the box it is given, so a box as tall as the whole head puts
       the crowd behind the type and leaves the sky where the picture is actually
       seen. Ending a little below the first line keeps the subject in the clear
       and still carries the picture under the words. */
    inset: 0 0 auto;
    height: calc(var(--tube) + 9rem);
    z-index: 0;
  }
  /*
   * Not a decorative wash. The picture runs untouched down to two thirds of
   * `--tube` and the type below keeps a ground it can be read off, with a tenth
   * of the broadcast still coming through so the head reads as glass rather
   * than as a panel laid over one. The readouts pay for that in ink rather than
   * in opacity: they run at `--sl-text-secondary` here, not the site's muted
   * grey, which on paper measures 3.49:1 against bare canvas and has nothing
   * left to give. Measured with scripts/contrast-probe.mjs.
   */
  .tlog-open::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      transparent 0,
      transparent calc(var(--tube) * 0.62),
      color-mix(in srgb, var(--sl-bg-canvas) 62%, transparent) calc(var(--tube) * 0.85),
      color-mix(in srgb, var(--sl-bg-canvas) 88%, transparent) var(--tube),
      color-mix(in srgb, var(--sl-bg-canvas) 96%, transparent) 100%
    );
  }
  .tlog-open__inner { position: relative; z-index: 2; }

  /* Asymmetric head: oversized wordmark left, the operator controls right,
     both sitting on the same baseline rule. */
  .tlog-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 3rem);
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--sl-border-subtle);
  }
  @media (min-width: 52rem) {
    .tlog-head { grid-template-columns: 1.5fr 0.85fr; align-items: end; }
    .tlog-head__side { padding-bottom: 0.5rem; }
  }
  .tlog-head__h {
    /* .sl-fx-glitch is inline-block, and .sl-eyebrow above is inline-flex: left
       as an inline box this heading shares a line with the eyebrow. */
    display: block;
    font-family: var(--sl-font-display);
    font-weight: 600;
    font-size: var(--step-display);
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 1.75rem 0 0;
    --gx: 6px;
  }

  /* Search: the kit's field. The kit makes .sl-field a flex column, which
     outranks the UA's [hidden] rule, so the JS-only reveal needs this back. */
  .tsearch[hidden] { display: none; }

  .tlog-head .sl-eyebrow { color: var(--sl-text-secondary); }
  .tlog-count {
    margin: 1.25rem 0 0;
    font-family: var(--sl-font-mono);
    font-weight: 500;
    font-size: var(--sl-text-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-text-secondary);
  }

  .tlog { list-style: none; margin: 0; padding: 0; }
  .tlog[hidden] { display: none; }

  .trow {
    display: grid;
    grid-template-columns: auto 3px 1fr auto auto;
    align-items: start;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
    padding-inline: clamp(0.5rem, 2vw, 1.25rem);
    margin-inline: clamp(-0.5rem, -2vw, -1.25rem);
    border-bottom: 1px solid var(--sl-border-subtle);
    text-decoration: none;
    color: inherit;
    transition: background var(--sl-motion-mid) var(--sl-motion-ease);
  }
  .trow:hover { background: var(--sl-bg-surface); }
  /* The focused row stands above its neighbours, which otherwise paint over
     the ring's outer edge (the first row's top). The ring sits 1px in, over
     the row's own rule, so it is 2px on every side; at offset 0 the rule
     joined it and the bottom read 3px. */
  .trow:focus-visible {
    position: relative;
    z-index: 1;
    outline-offset: -1px;
    border-bottom-color: var(--slc-focus);
  }

  /* Stamp column: the log's spine. Date over serial, both mono. */
  .trow__stamp {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.1em;
  }
  .trow__date {
    font-weight: var(--mono-light);
    color: var(--sl-text-secondary);
    font-variant-numeric: tabular-nums;
    transition: color var(--sl-motion-fast) var(--sl-motion-ease);
  }
  .trow:hover .trow__date { color: var(--slc-accent-text); }
  .trow__no { font-weight: var(--mono-hair); color: var(--sl-text-muted); }

  /* Vertical rule fills from the top on hover: the signal locking on. */
  .trow__rule {
    align-self: stretch;
    background: var(--slc-accent-text);
    opacity: 0;
    transform: scaleY(0);
    transform-origin: top;
    transition:
      transform var(--sl-motion-mid) var(--sl-motion-ease),
      opacity var(--sl-motion-mid) var(--sl-motion-ease);
  }
  .trow:hover .trow__rule { opacity: 1; transform: scaleY(1); }

  .trow__main { display: block; min-width: 0; }
  .trow__title {
    display: block;
    font-family: var(--sl-font-display);
    font-weight: 600;
    font-size: var(--step-h3);
    line-height: 1.1;
    letter-spacing: -0.03em;
    transition: color var(--sl-motion-fast) var(--sl-motion-ease);
  }
  .trow:hover .trow__title { color: var(--slc-accent-text); }
  .trow__summary {
    display: block;
    margin-top: 0.6rem;
    max-width: 54ch;
    font-size: var(--sl-text-sm);
    line-height: var(--sl-line-normal);
    color: var(--sl-text-secondary);
  }

  .trow__mins {
    font-family: var(--sl-font-mono);
    font-weight: var(--mono-hair);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.1em;
    color: var(--sl-text-muted);
    white-space: nowrap;
  }
  .trow__go {
    font-size: var(--sl-text-lg);
    color: var(--slc-accent-text);
    opacity: 0;
    transform: translateX(-0.4rem);
    transition:
      opacity var(--sl-motion-mid) var(--sl-motion-ease),
      transform var(--sl-motion-mid) var(--sl-motion-ease);
  }
  .trow:hover .trow__go { opacity: 1; transform: translateX(0); }

  @media (max-width: 46rem) {
    .trow {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'stamp mins'
        'main  main';
      align-items: baseline;
      gap: 0.9rem;
    }
    .trow__stamp {
      grid-area: stamp;
      flex-direction: row;
      align-items: baseline;
      gap: 0.75rem;
    }
    .trow__mins { grid-area: mins; }
    .trow__main { grid-area: main; }
    .trow__rule,
    .trow__go { display: none; }
  }

  /* The kit's void (0.41) frames the line in a Molnár field. The floor (the
     kit showcase's) leaves strokes above and below the 150px erased zone from
     390px up; below that the 210px zone fills the height and the strokes
     frame the sides. The kit holds secondary text, not muted, to 4.5:1 on the
     strokes, and at phone width the line is wider than that zone, so it takes
     the secondary ink. */
  .tlog-empty {
    margin: 2.5rem 0 0;
    min-height: 13rem;
    font-family: var(--sl-font-mono);
    font-weight: var(--mono-hair);
    font-size: var(--sl-text-sm);
    letter-spacing: 0.08em;
    color: var(--slc-text-secondary);
  }
  .tlog-empty[hidden] { display: none; }

  /* The pager is the kit's pagination; the site keeps its spacing, and the
     same [hidden] guard as the search (the filter hides the pager). */
  .tpager {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    flex-wrap: wrap;
  }
  .tpager[hidden] { display: none; }
  .tpager__off { opacity: 0.5; }
</style>

<script>
  import { autoBurst, scramble } from '@sondalab/ui-kit/effects.js';

  const heading = document.querySelector('.tlog-head__h.sl-fx-glitch');
  if (heading) autoBurst(heading, { waitMin: 5000, waitMax: 10000 });

  /** Decode-scramble a row's date stamp on hover: the log re-reading itself. */
  function armRows(root: ParentNode) {
    for (const row of root.querySelectorAll('.trow')) {
      const date = row.querySelector<HTMLElement>('.trow__date');
      if (date) row.addEventListener('mouseenter', () => scramble(date));
    }
  }
  armRows(document);

  type Hit = {
    slug: string;
    title: string;
    summary: string;
    stamp: string;
    iso: string;
    no: string;
    mins: number;
  };

  const box = document.querySelector<HTMLElement>('[data-tsearch-box]');
  const input = document.querySelector<HTMLInputElement>('[data-tsearch]');
  const list = document.querySelector<HTMLElement>('[data-tlist]');
  const results = document.querySelector<HTMLElement>('[data-tresults]');
  const empty = document.querySelector<HTMLElement>('[data-tempty]');
  const count = document.querySelector<HTMLElement>('[data-tcount]');
  const pager = document.querySelector<HTMLElement>('[data-tpager]');
  const tpl = document.querySelector<HTMLTemplateElement>('[data-trow-template]');

  // The field only exists for visitors who can actually use it; without JS the
  // page stays a paginated archive rather than showing a dead input.
  if (box && input && list && results && empty && count && tpl) {
    box.hidden = false;
    const total = count.textContent ?? '';

    let index: Hit[] | null = null;
    let loading: Promise<Hit[]> | null = null;

    /** Fetched once, on the first keystroke: an empty filter costs nothing. */
    function load(): Promise<Hit[]> {
      if (index) return Promise.resolve(index);
      if (!loading) {
        loading = fetch('/blog/search.json')
          .then((r) => r.json())
          .then((data: Hit[]) => (index = data));
      }
      return loading;
    }

    /**
     * Lowercase and strip diacritics, so `erdos` finds `Erdős` and `cafe`
     * finds `café`. Titles here are English but carry borrowed names.
     */
    function fold(text: string): string {
      return text
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    /** Every whitespace-separated term must appear somewhere in the entry. */
    function match(hit: Hit, terms: string[]): boolean {
      const hay = fold(`${hit.title} ${hit.summary} ${hit.stamp}`);
      return terms.every((t) => hay.includes(t));
    }

    function row(h: Hit): Node {
      const li = tpl!.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const set = (sel: string, text: string) => {
        li.querySelector(sel)!.textContent = text;
      };
      li.querySelector('a')!.setAttribute('href', `/blog/${h.slug}/`);
      const date = li.querySelector<HTMLElement>('.trow__date')!;
      date.setAttribute('datetime', h.iso);
      date.dataset.num = h.stamp;
      date.textContent = h.stamp;
      set('.trow__no', `// ${h.no}`);
      set('.trow__title', h.title);
      set('.trow__summary', h.summary);
      set('.trow__mins', `${h.mins} min`);
      return li;
    }

    function render(hits: Hit[]) {
      results!.replaceChildren(...hits.map(row));
      armRows(results!);
    }

    function reset() {
      list!.hidden = false;
      results!.hidden = true;
      empty!.hidden = true;
      if (pager) pager.hidden = false;
      count!.textContent = total;
    }

    function apply() {
      const q = fold(input!.value.trim());
      if (!q) {
        reset();
        return;
      }
      load().then((data) => {
        // The field may have been cleared while the index was in flight.
        if (!input!.value.trim()) return;
        const hits = data.filter((h) => match(h, q.split(/\s+/)));
        render(hits);
        list!.hidden = true;
        results!.hidden = hits.length === 0;
        empty!.hidden = hits.length > 0;
        if (pager) pager.hidden = true;
        count!.textContent = `// ${hits.length} of ${data.length} matching`;
      });
    }

    input.addEventListener('input', apply);
    // Escape clears a type=search field; Chrome reports that as `search`, not
    // `input`, so without this the list would stay filtered on an empty query.
    input.addEventListener('search', apply);
  }
</script>
