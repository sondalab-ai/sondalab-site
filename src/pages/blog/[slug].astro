---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, readingTime, formatDate, isoDate, type Post } from '../../lib/blog';
import { extractSources } from '../../lib/sources';
import { PAGE_POSTER_LOOKS, posterSequence } from '../../lib/posters';

export async function getStaticPaths() {
  const posts = await getPosts();
  const total = posts.length;
  const noOf = (i: number) => String(total - i).padStart(2, '0');
  // Read newest first, from the archive: the newest post steps past the
  // archive's own composition.
  const posters = posterSequence(posts.map((p) => p.id), PAGE_POSTER_LOOKS.blog[0]);
  return posts.map((post, i) => {
    // Newest first, so the neighbour above is the newer transmission. Read next
    // is the older one, the way a log is read; the oldest points back up.
    const nextIndex = i + 1 < total ? i + 1 : i - 1;
    return {
      params: { slug: post.id },
      props: {
        post,
        poster: posters.get(post.id)!,
        newer: posts[i - 1] ?? null,
        next: posts[nextIndex] ?? null,
        nextNo: noOf(nextIndex),
        no: noOf(i),
      },
    };
  });
}

interface Props {
  post: Post;
  poster: string;
  newer: Post | null;
  next: Post | null;
  nextNo: string;
  no: string;
}

const { post, poster, newer, next, nextNo, no } = Astro.props;
const sources = extractSources(post.body ?? '');
const { Content } = await render(post);

const stamp = formatDate(post.data.date);
const iso = isoDate(post.data.date);
const mins = readingTime(post.body);

const TITLE_BANDS = 6;
const titleShards = Array.from({ length: TITLE_BANDS }, (_, i) => i);
const NAV_BANDS = 5;
const navShards = Array.from({ length: NAV_BANDS }, (_, i) => i);
---

<Base title={post.data.title} description={post.data.summary}>
  <article class="post">
    <div class="sl-wrap">
      <a class="post__back" href="/blog/">← All transmissions</a>

      <header class="post__head">
        <div class="post__intro">
          <p class="sl-eyebrow">Transmission // {no}</p>
          <h1
            class="post__title sl-fx-glitch sl-fx-glitch--shatter"
            data-text={post.data.title}
            style={`--slfx-n:${TITLE_BANDS}`}
          >
            <span class="sl-fx-glitch__text">{post.data.title}</span>
            <span class="sl-fx-glitch__shards" aria-hidden="true">
              {titleShards.map((i) => (
                <span class="sl-fx-glitch__shard" style={`--slfx-i:${i}`}>{post.data.title}</span>
              ))}
            </span>
          </h1>
          <p class="post__stamp">
            <time datetime={iso} data-num={stamp}>{stamp}</time>
            <span class="post__sep" aria-hidden="true">·</span>
            <span>{mins} min</span>
          </p>
        </div>
        <div class={`post__poster ${poster}`} aria-hidden="true"></div>
      </header>

      <p class="post__standfirst">{post.data.summary}</p>

      <div class="post__read">
        <div class="post__body sl-prose article-prose">
          <Content />
        </div>
        {sources.length > 0 && (
          <aside class="post__sources" aria-label="Sources">
            <p class="post__sources-title">Sources</p>
            <ol>
              {sources.map((s) => (
                <li class="post__source">
                  <span class="post__source-host"><span class="post__source-n">{s.n}</span>{s.host}</span>
                  <a href={s.href} target="_blank" rel="noopener noreferrer">{s.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )}
      </div>

      {next && (
        <a class="post__next" href={`/blog/${next.id}/`}>
          <span class="post__next-eyebrow">Read next · Transmission // {nextNo}</span>
          <span
            class="post__next-title sl-fx-glitch sl-fx-glitch--shatter"
            data-text={next.data.title}
            style={`--slfx-n:${NAV_BANDS}`}
          >
            <span class="sl-fx-glitch__text">{next.data.title}</span>
            <span class="sl-fx-glitch__shards" aria-hidden="true">
              {navShards.map((i) => (
                <span class="sl-fx-glitch__shard" style={`--slfx-i:${i}`}>{next.data.title}</span>
              ))}
            </span>
          </span>
          <span class="post__next-summary">{next.data.summary}</span>
          <span class="post__next-go" aria-hidden="true">Read →</span>
        </a>
      )}
      {newer && newer !== next && (
        <a class="post__newer" href={`/blog/${newer.id}/`}>← Newer · {newer.data.title}</a>
      )}
    </div>
  </article>
</Base>

<style>
  /* overflow-x: clip, because the glitch's shard copies of a long title do not
     wrap with it and pushed the page 100px+ wider on a phone. Clip, not hidden:
     no scroll container, so nothing sticky inside is affected. */
  .post { padding-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem); overflow-x: clip; }

  .post__back {
    display: inline-block;
    /* A link you operate: sentence-case Geist at the control step (ui-kit
       0.30, L1), not a mono micro label. */
    font-family: var(--sl-font-sans);
    font-weight: 500;
    font-size: var(--sl-text-sm);
    text-decoration: none;
    color: var(--sl-text-muted);
    transition: color var(--sl-motion-fast) var(--sl-motion-ease);
  }
  .post__back:hover { color: var(--slc-accent-text); }

  /* The rule runs the full measure; only the type is held to a narrow column. */
  /* The head is the text and the post's poster (src/lib/posters.ts) beside
     it, never behind it (owner, 2026-10-26); below 64rem the poster drops
     under the text, aligned to the end. Widths are whole multiples of
     48px, so the kit's cell (the width over 48) loses nothing to rounding. */
  .post__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--sl-border-subtle);
  }
  .post__poster { width: 192px; justify-self: end; }
  @media (max-width: 29.99rem) {
    .post__poster { width: 144px; }
  }
  @media (min-width: 64rem) {
    .post__head { grid-template-columns: minmax(0, 1fr) auto; column-gap: 3rem; align-items: end; }
    .post__poster { width: 288px; }
  }
  /* A burst's shard copies do not wrap with the title: held to its box, plus
     the jitter, so they never cross into the poster's column. */
  .post__title .sl-fx-glitch__shards { overflow: clip; overflow-clip-margin: 1.25rem; }
  .post__title {
    /* .sl-fx-glitch is inline-block, and .sl-eyebrow above is inline-flex: left
       as an inline box this heading shares a line with the eyebrow. */
    display: block;
    max-width: 18ch;
    font-family: var(--sl-font-display);
    font-weight: 600;
    font-size: var(--step-h2);
    line-height: 1.02;
    letter-spacing: -0.045em;
    margin: 1.75rem 0 0;
    --gx: 5px;
  }
  .post__stamp {
    margin: 1.5rem 0 0;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--sl-font-mono);
    font-weight: 500;
    font-size: var(--sl-text-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-text-muted);
  }
  .post__stamp time {
    color: var(--slc-accent-text);
    font-variant-numeric: tabular-nums;
  }

  /* The summary, promoted to a standfirst: what the post argues, before it argues it. */
  .post__standfirst {
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    max-width: 34ch;
    font-family: var(--sl-font-display);
    font-weight: 400;
    font-size: clamp(1.3rem, 1.05rem + 0.8vw, 1.7rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--sl-text-secondary);
  }

  /* The text and its sources: the sources take the margin beside the paragraph
     that cites them (the page script sets each one's height), and fall below
     the post where there is no margin. */
  .post__read {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-top: clamp(2.25rem, 4.5vw, 3.5rem);
  }
  @media (min-width: 64rem) {
    .post__read {
      grid-template-columns: minmax(0, 68ch) minmax(12rem, 1fr);
      column-gap: clamp(2rem, 5vw, 4.5rem);
    }
  }

  /* Each external link carries its source number, from a counter over the same
     links the list is built from (src/lib/sources.ts). The alt text keeps the
     number out of the link's accessible name. */
  .post__body { counter-reset: src; }
  .post__body :global(a[href^='http']:not([href*='sondalab.eu']))::after {
    counter-increment: src;
    content: counter(src);
    content: counter(src) / '';
    margin-left: 0.12em;
    font-family: var(--sl-font-mono);
    font-size: 0.68em;
    vertical-align: super;
    line-height: 0;
    color: var(--slc-accent-text);
  }

  .post__sources {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-border-subtle);
  }
  .post__sources ol { list-style: none; margin: 0; padding: 0; }
  .post__sources-title,
  .post__source-host {
    font-family: var(--sl-font-mono);
    font-weight: 500;
    font-size: var(--sl-text-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-text-secondary);
  }
  .post__sources-title { margin: 0 0 1rem; }
  .post__source { margin: 0 0 1rem; padding-left: 0.9rem; border-left: 1px solid var(--sl-border-subtle); }
  .post__source-host { display: block; margin-bottom: 0.25rem; }
  .post__source-n { color: var(--slc-accent-text); margin-right: 0.6em; }
  .post__source a {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    line-height: 1.55;
    color: var(--sl-text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--sl-border-default);
  }
  .post__source a:hover { border-bottom-color: var(--slc-accent-text); }
  /* Its underline joins the focus ring (site.css): left neutral it is a band. */
  .post__source a:focus-visible { border-bottom-color: var(--slc-focus); }
  @media (min-width: 64rem) {
    .post__sources { margin-top: 0; padding-top: 0; border-top: 0; position: relative; }
    .post__sources-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    /* Placed by the page script level with the citing paragraph; without it
       they simply stack at the top of the margin. */
    .post__sources.is-placed .post__source { position: absolute; left: 0; right: 0; margin: 0; }
  }

  /* The ending: the next transmission, large enough to be an invitation. */
  .post__next {
    display: grid;
    gap: 0.9rem;
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-top: 2rem;
    border-top: 1px solid var(--sl-border-subtle);
    text-decoration: none;
    color: inherit;
  }
  .post__next-eyebrow {
    font-family: var(--sl-font-mono);
    font-weight: 500;
    font-size: var(--sl-text-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--slc-accent-text);
  }
  .post__next-title {
    display: block;
    max-width: 20ch;
    font-family: var(--sl-font-display);
    font-weight: 600;
    font-size: var(--step-h2);
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: var(--sl-text-primary);
    transition: color var(--sl-motion-fast) var(--sl-motion-ease);
    --gx: 4px;
  }
  .post__next:hover .post__next-title { color: var(--slc-accent-text); }
  /* The ending's rule joins the focus ring (site.css): left neutral it is a band. */
  .post__next:focus-visible { border-top-color: var(--slc-focus); }
  .post__next-summary { max-width: 52ch; color: var(--sl-text-secondary); line-height: var(--sl-line-normal); }
  .post__next-go {
    justify-self: start;
    margin-top: 0.5rem;
    /* The ending's action, so control text (L1): sentence-case Geist. */
    font-family: var(--sl-font-sans);
    font-weight: 500;
    font-size: var(--sl-text-sm);
    color: var(--sl-text-primary);
    border-bottom: 1px solid var(--slc-accent-text);
    padding-bottom: 0.2rem;
  }
  /* Control text, as the back link and "Read" are (L1). */
  .post__newer {
    display: inline-block;
    margin-top: 2.5rem;
    font-family: var(--sl-font-sans);
    font-weight: 500;
    font-size: var(--sl-text-sm);
    text-decoration: none;
    color: var(--sl-text-secondary);
  }
  .post__newer:hover { color: var(--slc-accent-text); }
</style>

<script>
  import { autoBurst, hoverBurst, scramble } from '@sondalab/ui-kit/effects.js';

  const title = document.querySelector('.post__title.sl-fx-glitch');
  if (title) autoBurst(title, { waitMin: 5000, waitMax: 10000 });

  // The stamp re-reads itself once the title has settled, like a decoding header.
  const stamp = document.querySelector<HTMLElement>('.post__stamp time');
  if (stamp) window.setTimeout(() => scramble(stamp), 400);

  const next = document.querySelector('.post__next');
  const nextTitle = next?.querySelector('.post__next-title.sl-fx-glitch');
  if (next && nextTitle) hoverBurst(next, nextTitle);

  // Each source sits level with the link that cites it, pushed down when the
  // one above it would overlap. Only where the sources have a margin to sit in.
  const aside = document.querySelector<HTMLElement>('.post__sources');
  const body = document.querySelector<HTMLElement>('.post__body');
  const wide = matchMedia('(min-width: 64rem)');
  function place() {
    if (!aside || !body) return;
    const items = [...aside.querySelectorAll<HTMLElement>('.post__source')];
    if (!wide.matches) {
      aside.classList.remove('is-placed');
      aside.style.height = '';
      for (const li of items) li.style.top = '';
      return;
    }
    const links = [...body.querySelectorAll<HTMLAnchorElement>('a[href^="http"]:not([href*="sondalab.eu"])')];
    const top0 = aside.getBoundingClientRect().top;
    let floor = 0;
    aside.classList.add('is-placed');
    items.forEach((li, i) => {
      const y = Math.max((links[i]?.getBoundingClientRect().top ?? top0) - top0, floor);
      li.style.top = `${y}px`;
      floor = y + li.offsetHeight + 16;
    });
    aside.style.height = `${floor}px`;
  }
  place();
  document.fonts?.ready.then(place);
  wide.addEventListener('change', place);
  addEventListener('resize', place);
</script>
