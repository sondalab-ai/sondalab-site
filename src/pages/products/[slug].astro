---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { accentVars, type AccentKey } from '../../lib/accents';
import { STATUS_META } from '../../lib/site';
import { NOVELLAS } from '../../lib/novellas';
import { Image } from 'astro:assets';
import { SCREENS } from '../../lib/screens';
import { posterSequence } from '../../lib/posters';

export async function getStaticPaths() {
  const products = (await getCollection('products')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  const posters = posterSequence(products.map((p) => p.id));
  return products.map((p, i) => ({
    params: { slug: p.id },
    props: {
      product: p,
      poster: posters.get(p.id)!,
      prev: products[i - 1] ?? null,
      next: products[i + 1] ?? null,
      total: products.length,
    },
  }));
}

const { product, poster, prev, next, total } = Astro.props;
const { data } = product;
const { Content } = await render(product);

const novella = NOVELLAS[product.id];
const chapter = String(data.order + 1).padStart(2, '0');
const chapterTotal = String(total).padStart(2, '0');
const logMarker = `// operator's log · ${chapter} / ${chapterTotal}`;

const acc = accentVars(data.accent as AccentKey);
const meta = data.status ? STATUS_META[data.status] : null;
const screens = SCREENS[product.id] ?? [];

const NAME_BANDS = 6;
const nameShards = Array.from({ length: NAME_BANDS }, (_, i) => i);
const NAV_BANDS = 4;
const navShards = Array.from({ length: NAV_BANDS }, (_, i) => i);
---

<Base title={data.name} description={data.summary.replace(/<[^>]+>/g, '')}>
  <article
    class="product"
    data-product
    style={`--acc-light:${acc.light};--acc-dark:${acc.dark};--acc-fill-light:${acc.fill.light};--acc-fill-dark:${acc.fill.dark}`}
  >
    <div class="sl-wrap">
      <a class="product__back" href="/#products">← All tools</a>

      <header class="product__head">
        <div class="product__intro">
          <p class="sl-eyebrow">{data.kind === 'research' ? 'Research' : 'Tool'} · {data.form}</p>
          <h1
            class="product__name sl-fx-glitch sl-fx-glitch--shatter"
            data-text={data.name}
            style={`--slfx-n:${NAME_BANDS}`}
          >
            <span class="sl-fx-glitch__text">{data.name}</span>
            <span class="sl-fx-glitch__shards" aria-hidden="true">
              {nameShards.map((i) => (
                <span class="sl-fx-glitch__shard" style={`--slfx-i:${i}`}>{data.name}</span>
              ))}
            </span>
          </h1>
          <p class="product__tagline">{data.tagline}</p>

          {meta && (
            <div class="product__meta">
              <span class="sl-tag">{meta.label}</span>
              <span class="product__meta-note">{meta.note}</span>
            </div>
          )}

          {data.fullPage && (
            <p class="product__full">
              <a class="sl-btn sl-btn--primary sl-fx-glass sl-fx-glass--pane sl-fx-press sl-fx-aurora sl-fx-aurora--rim" href={data.fullPage.href}>{data.fullPage.label} →</a>
            </p>
          )}
        </div>
        <div class={`product__poster ${poster}`} aria-hidden="true"></div>
      </header>

      <div class="product__body">
        <div class="sl-prose">
          <Content />
        </div>

        <aside class="product__aside">
          <dl class="factsheet">
            {meta && <div><dt>Status</dt><dd>{meta.label}</dd></div>}
            <div><dt>Form</dt><dd>{data.form}</dd></div>
          </dl>

          {(data.repoPublic || data.links.length > 0) && (
            <div class="product__links">
              {data.repoPublic && data.repo && (
                <a class="sl-btn sl-btn--primary sl-fx-glass sl-fx-glass--pane sl-fx-press sl-fx-aurora sl-fx-aurora--rim" href={data.repo} target="_blank" rel="noopener noreferrer">Source on GitHub</a>
              )}
              {data.links.map((l) => (
                <a class="sl-link" href={l.href} target="_blank" rel="noopener noreferrer">{l.label} →</a>
              ))}
            </div>
          )}
          {!data.repoPublic && (
            <p class="product__private">Source is currently private.</p>
          )}
        </aside>
      </div>

      {screens.length > 0 && (
        <section class="shots" aria-label={`${data.name} in use`}>
          <p class="sl-eyebrow">In use</p>
          <ol class="shots__track">
            {screens.map((s) => (
              <li class="shots__item">
                <figure>
                  <Image src={s.src} alt={s.alt} widths={[640, 1200, 1800]} sizes="(max-width: 52rem) 88vw, 60vw" loading="lazy" />
                  <figcaption>{s.caption}</figcaption>
                </figure>
              </li>
            ))}
          </ol>
        </section>
      )}

      {novella && (
        <aside class="novella" data-novella>
          <span class="novella__marker sl-fx-glitch" data-text={logMarker}>{logMarker}</span>
          <div class="novella__body">
            {novella.map((para) => (
              <p class="novella__p">{para}</p>
            ))}
          </div>
        </aside>
      )}

      <nav class="product__nav" aria-label="Other tools">
        {prev ? (
          <a class="product__nav-link product__nav-link--prev" href={`/products/${prev.id}/`}>
            <span class="product__nav-dir">← Previous</span>
            <span
              class="product__nav-name sl-fx-glitch sl-fx-glitch--shatter"
              data-text={prev.data.name}
              style={`--slfx-n:${NAV_BANDS}`}
            >
              <span class="sl-fx-glitch__text">{prev.data.name}</span>
              <span class="sl-fx-glitch__shards" aria-hidden="true">
                {navShards.map((i) => (
                  <span class="sl-fx-glitch__shard" style={`--slfx-i:${i}`}>{prev.data.name}</span>
                ))}
              </span>
            </span>
          </a>
        ) : <span />}
        {next ? (
          <a class="product__nav-link product__nav-link--next" href={`/products/${next.id}/`}>
            <span class="product__nav-dir">Next →</span>
            <span
              class="product__nav-name sl-fx-glitch sl-fx-glitch--shatter"
              data-text={next.data.name}
              style={`--slfx-n:${NAV_BANDS}`}
            >
              <span class="sl-fx-glitch__text">{next.data.name}</span>
              <span class="sl-fx-glitch__shards" aria-hidden="true">
                {navShards.map((i) => (
                  <span class="sl-fx-glitch__shard" style={`--slfx-i:${i}`}>{next.data.name}</span>
                ))}
              </span>
            </span>
          </a>
        ) : <span />}
      </nav>
    </div>
  </article>
</Base>

<style>
  /* Repaint the accent from the product's registered hue. The kit's accent
     roles compute on :root from the default accent, so the ones this page's
     content reads are re-derived here with the kit's own formulas: the accent,
     its 12% wash, the accent as text (capped on light at
     --sl-accent-text-lmax, where the raw accent is a fill), the ring, and the
     hover step, which the glitch's jitter mixes into a product name, a pager
     name and the log marker (effects.css). The glitch needs the product's hue,
     a step off: a fixed mix, lighter on ink and darker on paper, since the
     kit's own step rule (0.32.1) is a private macro and no primary reads this
     one (a set --slc-accent-fill derives its steps on the control).
     --sl-accent-default is for this page's own CSS. Only var()/color-mix
     here; the hex lives in the inline style attribute.

     The primary is the kit's contract since ui-kit 0.32: one role,
     --slc-accent-fill, set to the product's registered fill (the accent itself
     unless the registry names a deeper one, as it does for spexr). The kit's
     filled controls derive their fill set from it on themselves, so set on this
     subtree it reaches the primary's label, hover, press, edge and foot, opaque
     or glass; high contrast resets it on the control. */
  [data-product] {
    --sl-accent-default: var(--acc-dark);
    --slc-accent: var(--acc-dark);
    --slc-accent-fill: var(--acc-fill-dark);
    --slc-accent-hover: color-mix(in srgb, var(--slc-accent) 80%, white);
    --slc-accent-subtle: color-mix(in srgb, var(--slc-accent) 12%, transparent);
    --slc-accent-text: oklch(from var(--slc-accent) min(l, var(--sl-accent-text-lmax, 1)) c h);
    --slc-focus: var(--slc-accent-text);
  }
  :root[data-sl-theme='light'] [data-product] {
    --sl-accent-default: var(--acc-light);
    --slc-accent: var(--acc-light);
    --slc-accent-fill: var(--acc-fill-light);
    --slc-accent-hover: color-mix(in srgb, var(--slc-accent) 89%, black);
  }

  .product {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
    isolation: isolate;
  }
  /* Full-viewport background wash in the product's hue, fixed, behind content. */
  .product::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        120% 85% at 88% -12%,
        color-mix(in srgb, var(--sl-accent-default) 16%, transparent),
        transparent 58%
      ),
      radial-gradient(
        100% 75% at -12% 112%,
        color-mix(in srgb, var(--sl-accent-default) 11%, transparent),
        transparent 55%
      );
  }

  .product__back {
    display: inline-block;
    /* A link you operate: sentence-case Geist at the control step (ui-kit
       0.30, L1), not a mono micro label. */
    font-family: var(--sl-font-sans);
    font-weight: 500;
    font-size: var(--sl-text-sm);
    text-decoration: none;
    color: var(--sl-text-muted);
    transition: color var(--sl-motion-fast) var(--sl-motion-ease);
  }
  .product__back:hover { color: var(--slc-accent-text); }

  /* The head is the text and the product's poster (src/lib/posters.ts) beside
     it, never behind it (owner, 2026-10-26). Below 64rem the poster drops
     under the text, aligned to the end. Its widths are whole multiples of
     48px, so the kit's cell (the width over 48) loses nothing to rounding. */
  .product__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--sl-border-subtle);
  }
  .product__poster { width: 192px; justify-self: end; }
  @media (max-width: 29.99rem) {
    .product__poster { width: 144px; }
  }
  @media (min-width: 64rem) {
    .product__head { grid-template-columns: minmax(0, 1fr) auto; column-gap: 3rem; align-items: center; }
    .product__poster { width: 288px; }
  }
  @media (min-width: 80rem) {
    .product__poster { width: 384px; }
  }
  /* A burst's shard copies do not wrap with the name: held to its box, plus
     the jitter, so they never cross into the poster's column. */
  .product__name .sl-fx-glitch__shards { overflow: clip; overflow-clip-margin: 1.25rem; }
  .product__name {
    /* .sl-fx-glitch is inline-block, and .sl-eyebrow above is inline-flex: left
       as an inline box this heading shares a line with the eyebrow. */
    display: block;
    font-family: var(--sl-font-display);
    font-weight: 600;
    font-size: var(--step-display);
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 1.75rem 0 0;
    --gx: 6px;
  }
  .product__tagline {
    margin: 1.25rem 0 0;
    font-size: var(--sl-text-xl);
    line-height: var(--sl-line-tight);
    color: var(--sl-text-secondary);
    max-width: 24ch;
    font-family: var(--sl-font-display);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .product__meta {
    margin-top: 2rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  /* The long-form page, when a product has one: the head's one action, above
     the fold on every width (the aside falls below the prose on a phone). */
  .product__full { margin: 2rem 0 0; }
  .product__meta-note {
    font-family: var(--sl-font-mono);
    font-weight: var(--mono-hair);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.04em;
    color: var(--sl-text-muted);
  }

  .product__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 4.5rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 52rem) {
    .product__body { grid-template-columns: 1.6fr 0.9fr; align-items: start; }
    .product__aside { position: sticky; top: 6rem; }
  }

  .factsheet { margin: 0; display: grid; gap: 1rem; }
  .factsheet div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--sl-border-subtle);
  }
  .factsheet dt {
    font-family: var(--sl-font-mono);
    font-weight: 500;
    font-size: var(--sl-text-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-text-muted);
  }
  .factsheet dd {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-weight: var(--mono-hair);
    font-size: var(--sl-text-sm);
    color: var(--sl-text-primary);
  }

  .product__links {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .shots { margin-top: clamp(3rem, 7vw, 5rem); }
  .shots__track {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0 0 1rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(88vw, 60rem);
    gap: clamp(1rem, 3vw, 2rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }
  .shots__item { scroll-snap-align: start; }
  .shots__item figure { margin: 0; display: grid; gap: 0.75rem; }
  /* No border: the captures are macOS windows with their own frame and shadow. */
  .shots__item :global(img) { width: 100%; height: auto; }
  .shots__item figcaption {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.08em;
    color: var(--sl-text-secondary);
  }

  .product__private {
    margin-top: 2rem;
    font-family: var(--sl-font-mono);
    font-weight: var(--mono-hair);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.04em;
    color: var(--sl-text-muted);
  }

  .product__nav {
    margin-top: clamp(3rem, 7vw, 6rem);
    padding-top: 2rem;
    border-top: 1px solid var(--sl-border-subtle);
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .product__nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--sl-text-primary);
  }
  .product__nav-link--next { text-align: right; }
  /* Read with the link it sits in, so control text (L1): sentence-case
     Geist, the small control step. */
  .product__nav-dir {
    font-family: var(--sl-font-sans);
    font-weight: 500;
    font-size: var(--sl-text-xs);
    color: var(--sl-text-muted);
  }
  .product__nav-name {
    font-family: var(--sl-font-display);
    font-weight: 600;
    font-size: var(--step-h3);
    letter-spacing: -0.03em;
    transition: color var(--sl-motion-fast) var(--sl-motion-ease);
    --gx: 3px;
  }
  .product__nav-link:hover .product__nav-name { color: var(--slc-accent-text); }

  /* --- operator's log (serial novella) --- */
  .novella {
    margin-top: clamp(3rem, 7vw, 6rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--sl-border-subtle);
    max-width: 46rem;
  }
  .novella__marker {
    display: inline-block;
    font-family: var(--sl-font-mono);
    font-weight: 500;
    font-size: var(--sl-text-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--slc-accent-text);
    --gx: 2px;
  }
  .novella__body {
    margin-top: 1.6rem;
    padding-left: clamp(1rem, 3vw, 2rem);
    border-left: 2px solid color-mix(in srgb, var(--slc-accent-text) 40%, transparent);
  }
  /* Upright since ui-kit 0.30 (was Fraunces italic): Geist has no italic and
     the kit serves none. The accent rule and the secondary ink set it apart. */
  .novella__p {
    margin: 0 0 1.15rem;
    font-family: var(--sl-font-display);
    font-weight: 400;
    font-size: clamp(1.2rem, 1.05rem + 0.45vw, 1.35rem);
    line-height: 1.65;
    color: var(--sl-text-secondary);
  }
  /* The recurring refrain lands in the product's hue. */
  .novella__p:last-child {
    margin-bottom: 0;
    color: var(--slc-accent-text);
  }
  /* Staggered reveal, progressive enhancement: JS arms the hidden state. */
  .novella[data-armed] .novella__marker,
  .novella[data-armed] .novella__body {
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity var(--sl-motion-slow) var(--sl-motion-ease),
      transform var(--sl-motion-slow) var(--sl-motion-ease);
  }
  .novella[data-armed].is-in .novella__marker { opacity: 1; transform: none; }
  .novella[data-armed].is-in .novella__body {
    opacity: 1;
    transform: none;
    transition-delay: 90ms;
  }
</style>

<script>
  import { autoBurst, hoverBurst, burst } from '@sondalab/ui-kit/effects.js';

  // Product title glitches ambiently (per-product accent via the page's --sl-accent-default).
  const name = document.querySelector('.product__name.sl-fx-glitch');
  if (name) autoBurst(name, { waitMin: 4000, waitMax: 8000 });

  // Prev/next names sl-fx-glitch on hover, in bursts with random pauses.
  for (const link of document.querySelectorAll('.product__nav-link')) {
    const nm = link.querySelector('.product__nav-name.sl-fx-glitch');
    if (nm) hoverBurst(link, nm);
  }

  // Operator's log: reveal on scroll + sl-fx-glitch the marker, then keep it ticking.
  const log = document.querySelector('[data-novella]');
  if (log && 'IntersectionObserver' in window) {
    log.setAttribute('data-armed', '');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
            const marker = e.target.querySelector('.novella__marker.sl-fx-glitch');
            if (marker) {
              burst(marker);
              autoBurst(marker, { waitMin: 6000, waitMax: 12000 });
            }
          }
        }
      },
      { threshold: 0.25 },
    );
    io.observe(log);
  }
</script>
