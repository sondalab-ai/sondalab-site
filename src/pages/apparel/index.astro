---
import { Image } from 'astro:assets';

import Base from '../../layouts/Base.astro';
import { APPAREL, categoryHref } from '../../lib/apparel';
import { SITE } from '../../lib/site';

const { storeUrl, categories } = APPAREL;
const open = storeUrl !== null;

const waitlistHref = `mailto:${SITE.email}?subject=${encodeURIComponent(
  'Apparel — tell me when it drops',
)}`;

// What the proceeds buy. Deliberately no figures and no percentages: a
// published split is a promise that has to stay true.
const ledger = [
  { key: 'compute', note: 'The runs that turn an idea into a result.' },
  { key: 'hardware', note: 'Machines that keep the work local.' },
  { key: 'time', note: 'The only input with no substitute.' },
];
---

<Base
  title="Apparel"
  description="Sondalab apparel: tees, caps and pants. Every piece funds the open-source research behind the tools."
>
  <section class="ap-open">
    <div class="wrap">
      <p class="eyebrow">Apparel</p>
      <h1 class="display ap-open__h">Wear the thesis.<br />Fund the work.</h1>
      <p class="lede ap-open__lede">
        Sondalab's tools are open, local, and free to run. None of that pays for
        itself. Apparel is how the research gets funded: you get something worth
        wearing, the work gets another month.
      </p>
    </div>
  </section>

  <section class="section ap-pact">
    <div class="wrap ap-pact__grid">
      <div>
        <div class="section-index">
          <span class="section-index__no">01</span>
          <span class="eyebrow">The pact</span>
        </div>
        <h2 class="h2">Independent work needs a source of money.</h2>
        <p class="ap-pact__body">
          Research that takes investment takes its incentives with it. The
          alternative is to find the money elsewhere, in the open, from the
          people who already believe the tools should stay local and legible.
          That is the entire idea behind this section: no sponsor, no roadmap
          sold in advance, no feature waiting on someone else's quarter.
        </p>
      </div>

      <ul class="ap-ledger">
        {ledger.map((l) => (
          <li class="ap-ledger__row">
            <span class="ap-ledger__key">{l.key}</span>
            <span class="ap-ledger__note">{l.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section ap-cats">
    <div class="wrap">
      <div class="section-index">
        <span class="section-index__no">02</span>
        <span class="eyebrow">The pieces</span>
      </div>

      <ol class="ap-cats__list">
        {categories.map((c, i) => {
          const href = categoryHref(c);
          const no = String(i + 1).padStart(2, '0');
          const inner = (
            <Fragment>
              <span class="crow__no">{no}</span>
              <span class="crow__rule" aria-hidden="true"></span>
              <span class="crow__main">
                <span class="crow__label">{c.label}</span>
                <span class="crow__note">{c.note}</span>
              </span>
              <span class="crow__img">
                {/* Decorative: the row's own text already names the piece. */}
                <Image src={c.image} alt="" widths={[240, 480]} sizes="(min-width: 40rem) 10rem, 100vw" />
              </span>
              <span class="crow__go" aria-hidden="true">{href ? '→' : '·'}</span>
            </Fragment>
          );
          return (
            <li>
              {href ? (
                <a class="crow" href={href} target="_blank" rel="noopener noreferrer">{inner}</a>
              ) : (
                <div class="crow crow--inert">{inner}</div>
              )}
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="section ap-band">
    <div class="wrap ap-band__inner">
      <p class="ap-band__state">{open ? '// open' : '// in preparation'}</p>
      {open ? (
        <a class="ap-band__cta" href={storeUrl!} target="_blank" rel="noopener noreferrer">
          Visit the store
        </a>
      ) : (
        <a class="ap-band__cta" href={waitlistHref}>Tell me when it drops</a>
      )}
    </div>
  </section>
</Base>

<style>
  /* --- opening ------------------------------------------------------- */
  .ap-open {
    padding-block: clamp(4rem, 10vw, 9rem) clamp(3rem, 7vw, 6rem);
  }
  .ap-open__h {
    margin-top: 1.5rem;
    max-width: 14ch;
  }
  .ap-open__lede {
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    max-width: 46ch;
  }

  /* --- the pact ------------------------------------------------------ */
  .ap-pact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 4rem);
  }
  @media (min-width: 52rem) {
    .ap-pact__grid { grid-template-columns: 1.1fr 0.9fr; align-items: start; }
  }
  .ap-pact__grid .h2 { margin-top: 1.25rem; max-width: 20ch; }
  .ap-pact__body {
    margin-top: 1.5rem;
    max-width: 52ch;
    color: var(--sl-text-secondary);
  }

  .ap-ledger { list-style: none; margin: 0; padding: 0; }
  .ap-ledger__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--sl-border-subtle);
  }
  .ap-ledger__row:last-child { border-bottom: 1px solid var(--sl-border-subtle); }
  .ap-ledger__key {
    font-family: var(--sl-font-mono);
    font-weight: 300;
    font-size: var(--sl-text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sl-accent-default);
  }
  .ap-ledger__note {
    font-size: var(--sl-text-sm);
    color: var(--sl-text-muted);
  }

  /* --- categories ---------------------------------------------------- */
  .ap-cats__list { list-style: none; margin: 0; padding: 0; }

  .crow {
    display: grid;
    grid-template-columns: auto 3px minmax(0, 1fr) auto auto;
    grid-template-areas: 'no rule main img go';
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(1.5rem, 3.5vw, 2.5rem);
    padding-inline: clamp(0.5rem, 2vw, 1.25rem);
    margin-inline: clamp(-0.5rem, -2vw, -1.25rem);
    border-top: 1px solid var(--sl-border-subtle);
    text-decoration: none;
    color: inherit;
    transition: background var(--sl-motion-mid) var(--sl-motion-ease);
  }
  .ap-cats__list li:last-child .crow {
    border-bottom: 1px solid var(--sl-border-subtle);
  }
  .crow:not(.crow--inert):hover {
    background: color-mix(in srgb, var(--sl-accent-default) 6%, transparent);
  }
  .crow:focus-visible {
    outline: var(--sl-focus-ring-width) solid var(--sl-accent-default);
    outline-offset: 2px;
  }

  .crow__no {
    grid-area: no;
    font-family: var(--sl-font-mono);
    font-weight: 100;
    font-size: var(--step-numeral);
    line-height: 0.8;
    color: var(--sl-text-muted);
    transition: color var(--sl-motion-mid) var(--sl-motion-ease);
  }
  .crow:not(.crow--inert):hover .crow__no { color: var(--sl-accent-default); }

  .crow__rule {
    grid-area: rule;
    align-self: stretch;
    width: 3px;
    background: var(--sl-accent-default);
    border-radius: var(--sl-radius-pill);
    transform: scaleY(0.35);
    transform-origin: center;
    opacity: 0.55;
    transition: transform var(--sl-motion-mid) var(--sl-motion-ease),
      opacity var(--sl-motion-mid) var(--sl-motion-ease);
  }
  .crow:not(.crow--inert):hover .crow__rule { transform: scaleY(1); opacity: 1; }

  .crow__main { grid-area: main; display: block; }

  .crow__img {
    grid-area: img;
    display: block;
    width: clamp(7rem, 12vw, 10rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--sl-border-default);
  }
  .crow__img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--sl-motion-mid) var(--sl-motion-ease);
  }
  .crow:not(.crow--inert):hover .crow__img :global(img) { transform: scale(1.04); }
  .crow__label {
    display: block;
    font-family: var(--sl-font-display);
    font-weight: 440;
    font-variation-settings: 'opsz' 60, 'WONK' 1;
    font-size: var(--step-h3);
    letter-spacing: -0.01em;
  }
  .crow__note {
    display: block;
    margin-top: 0.4rem;
    color: var(--sl-text-secondary);
    max-width: 48ch;
  }
  .crow__go {
    grid-area: go;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-lg);
    color: var(--sl-text-muted);
  }
  .crow:not(.crow--inert) .crow__go {
    color: var(--sl-accent-default);
    opacity: 0;
    transform: translateX(-0.4rem);
    transition: opacity var(--sl-motion-mid) var(--sl-motion-ease),
      transform var(--sl-motion-mid) var(--sl-motion-ease);
  }
  .crow:not(.crow--inert):hover .crow__go { opacity: 1; transform: translateX(0); }

  @media (max-width: 40rem) {
    .crow {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'no main'
        'img img';
      row-gap: 1.25rem;
    }
    .crow__rule, .crow__go { display: none; }
    .crow__img { width: 100%; aspect-ratio: 3 / 2; }
  }

  /* --- status band + call to action ---------------------------------- */
  .ap-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .ap-band__state {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-weight: 300;
    font-size: var(--sl-text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sl-text-muted);
  }
  .ap-band__cta {
    font-family: var(--sl-font-display);
    font-weight: 400;
    font-variation-settings: 'opsz' 48, 'WONK' 1;
    font-size: var(--step-h3);
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--sl-text-primary);
    border-bottom: 2px solid var(--sl-accent-default);
    padding-bottom: 0.15em;
    transition: color var(--sl-motion-fast) var(--sl-motion-ease);
  }
  .ap-band__cta:hover { color: var(--sl-accent-default); }
  .ap-band__cta:focus-visible {
    outline: var(--sl-focus-ring-width) solid var(--sl-accent-default);
    outline-offset: 3px;
  }
</style>
